diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..1c2cef2
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,38 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: var(--space-xs);
+  margin-top: var(--space-m);
+  padding: var(--space-s) 0;
+}
+
+.pagination a,
+.pagination .current {
+  display: inline-block;
+  padding: var(--space-xxs) var(--space-s);
+  border-radius: var(--border-radius);
+  text-decoration: none;
+  font-size: 0.9rem;
+}
+
+.pagination a {
+  color: var(--color-dark);
+  border: 1px solid var(--color-light);
+  background-color: var(--color-white);
+}
+
+.pagination a:hover {
+  background-color: var(--color-light);
+  color: var(--color-primary);
+}
+
+.pagination .current {
+  color: var(--color-white);
+  background-image: linear-gradient(to right, var(--color-primary), var(--color-primary-rotate));
+}
+
+.pagination .disabled {
+  color: var(--color-light);
+  pointer-events: none;
+}
