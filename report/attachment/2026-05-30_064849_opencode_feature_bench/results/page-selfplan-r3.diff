diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..c2a6783
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,48 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: var(--space-xs);
+  margin-top: var(--space-l);
+  padding: var(--space-m) 0;
+}
+
+.pagination a,
+.pagination span {
+  display: inline-block;
+  padding: var(--space-xxs) var(--space-s);
+  border-radius: var(--border-radius);
+  font-size: var(--font-size-s);
+  text-decoration: none;
+}
+
+.pagination a {
+  color: var(--color-text-body);
+  border: var(--border);
+  background-color: var(--color-white);
+  transition: background-color 200ms, color 200ms;
+}
+
+.pagination a:hover,
+.pagination a:focus {
+  background-color: var(--color-light);
+  color: var(--color-text-header);
+}
+
+.pagination a.current {
+  color: var(--color-white);
+  background-image: linear-gradient(to right, var(--color-primary), var(--color-primary-rotate));
+  border: solid 2px transparent;
+  font-weight: bold;
+}
+
+.pagination span.disabled {
+  color: var(--color-text-muted);
+  background-color: var(--color-light);
+  cursor: not-allowed;
+}
+
+.pagination .gap {
+  color: var(--color-text-muted);
+  padding: var(--space-xxs) var(--space-s);
+}
