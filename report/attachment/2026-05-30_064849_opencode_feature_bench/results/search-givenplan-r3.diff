diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..9d129a9 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,33 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "index with q parameter filters archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/aaa", title: "Ruby on Rails")
+    Archive.create!(original_url: "https://vimeo.com/bbb", title: "Python Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/ccc", title: "Rails API Guide")
+
+    get archives_url, params: { q: "Rails" }
+    assert_response :success
+    assert_select "h1", /保存したビデオ/
+
+    html = response.body
+    assert html.include?("Ruby on Rails")
+    assert html.include?("Rails API Guide")
+    assert_not html.include?("Python Tutorial")
+  end
+
+  test "index without q parameter shows all archives" do
+    Archive.create!(original_url: "https://vimeo.com/aaa", title: "Ruby on Rails")
+    Archive.create!(original_url: "https://vimeo.com/bbb", title: "Python Tutorial")
+
+    get archives_url
+    assert_response :success
+
+    html = response.body
+    assert html.include?("Ruby on Rails")
+    assert html.include?("Python Tutorial")
+  end
+
