diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..1ed27dd 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,29 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching records for partial match" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails API Guide")
+    Archive.create!(original_url: "https://vimeo.com/9999999", title: "Python Programming")
+
+    result = Archive.search_by_title("Ruby")
+    assert_equal 1, result.count
+    assert_includes result, archive1
+
+    result2 = Archive.search_by_title("rails")
+    assert_equal 2, result2.count
+    assert_includes result2, archive1
+    assert_includes result2, archive2
+  end
+
+  test "search_by_title returns empty for non-matching query" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+
+    result = Archive.search_by_title("NonExistentTitle")
+    assert_equal 0, result.count
+
+    result2 = Archive.search_by_title("")
+    assert_equal Archive.count, result2.count
+  end
 end
