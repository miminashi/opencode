diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..4e06c9b 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,37 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives with partial match" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Ruby 入門ガイド")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1234567", title: "Python で機械学習")
+
+    result = Archive.search_by_title("Ruby")
+    assert_equal 2, result.count
+    assert_includes result, archive1
+    assert_includes result, archive2
+  end
+
+  test "search_by_title returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python で機械学習")
+
+    result = Archive.search_by_title("Java")
+    assert_equal 0, result.count
+  end
+
+  test "search_by_title with empty query returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python 入門")
+    all_count = Archive.count
+    assert_equal all_count, Archive.search_by_title(nil).count
+  end
+
+  test "search_by_title is case insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails")
+    result = Archive.search_by_title("ruby")
+    assert_equal 1, result.count
+    assert_includes result, archive
+  end
 end
