diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..21e56e9 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,33 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns archives matching title substring" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Ruby Programming")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1182937", title: "Python Basics")
+
+    results = Archive.search("Ruby")
+    assert_equal 2, results.count
+    assert_includes results, archive1
+    assert_includes results, archive2
+    assert_not_includes results, archive3
+  end
+
+  test "search scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    results = Archive.search("JavaScript")
+    assert_equal 0, results.count
+  end
+
+  test "search scope returns all when query is blank" do
+    results = Archive.search("")
+    assert results.is_a?(ActiveRecord::Relation)
+  end
+
+  test "search scope is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    results = Archive.search("ruby")
+    assert_equal 1, results.count
+  end
 end
