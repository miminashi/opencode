diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..f69f227 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,49 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails 7 Deep Dive")
+    Archive.create!(original_url: "https://vimeo.com/1182937", title: "Python Programming")
+
+    results = Archive.search("rails")
+    assert_equal 2, results.count
+    assert_includes results.map(&:title), "Ruby on Rails Tutorial"
+    assert_includes results.map(&:title), "Rails 7 Deep Dive"
+  end
+
+  test "search scope returns no results for non-matching query" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python Programming")
+
+    results = Archive.search("javascript")
+    assert_equal 0, results.count
+  end
+
+  test "search scope with blank query returns all archives" do
+    count_before = Archive.count
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video One")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video Two")
+
+    results = Archive.search("")
+    assert_equal count_before + 2, results.count
+  end
+
+  test "search scope is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+
+    results = Archive.search("rails")
+    assert_equal 1, results.count
+
+    results_upper = Archive.search("RAILS")
+    assert_equal 1, results_upper.count
+  end
+
+  test "search scope returns partial match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+
+    results = Archive.search("on rails")
+    assert_equal 1, results.count
+  end
 end
