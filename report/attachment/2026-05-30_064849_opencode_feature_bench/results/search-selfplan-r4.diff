diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..5e6dde1 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,43 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns archives matching the query in title" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python Programming")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1182937", title: "Rails API Basics")
+
+    result = Archive.search("Ruby")
+    assert_equal 1, result.count
+    assert_includes result, archive1
+
+    result = Archive.search("Rails")
+    assert_equal 2, result.count
+    assert_includes result, archive1
+    assert_includes result, archive3
+
+    result = Archive.search("Python")
+    assert_equal 1, result.count
+    assert_includes result, archive2
+  end
+
+  test "search scope returns all archives when query is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video A")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video B")
+
+    result = Archive.search("")
+    assert_equal Archive.count, result.count
+  end
+
+  test "search scope is case insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails")
+
+    result = Archive.search("ruby")
+    assert_equal 1, result.count
+    assert_includes result, archive
+
+    result = Archive.search("RUBY")
+    assert_equal 1, result.count
+    assert_includes result, archive
+  end
 end
