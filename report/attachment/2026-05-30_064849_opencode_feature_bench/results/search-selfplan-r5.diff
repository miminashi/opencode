diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..725cdfb 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,22 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "by_title scope returns archives matching the query" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Ruby 入門ガイド")
+    Archive.create!(original_url: "https://vimeo.com/1182937", title: "Python で機械学習")
+
+    matching = Archive.by_title("Ruby")
+    assert_equal 2, matching.count
+    assert_includes matching.pluck(:title), "Ruby on Rails チュートリアル"
+    assert_includes matching.pluck(:title), "Ruby 入門ガイド"
+  end
+
+  test "by_title scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+
+    matching = Archive.by_title("Java")
+    assert_equal 0, matching.count
+  end
 end
