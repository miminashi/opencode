diff --git a/app/views/archives/index.html.erb b/app/views/archives/index.html.erb
index 993e337..4df5104 100644
--- a/app/views/archives/index.html.erb
+++ b/app/views/archives/index.html.erb
@@ -14,4 +14,26 @@
   <%= turbo_frame_tag("archives") do %>
     <%= render @archives %>
   <% end %>
+
+  <% if @pagy.pages > 1 %>
+    <nav class="pagination">
+      <% if @pagy.prev %>
+        <%= link_to @pagy.prev, archives_path(page: @pagy.prev), class: "pagination__link pagination__link--prev", data: {turbo_frame: "_top"} %>
+      <% end %>
+
+      <% for page in @pagy.pages %>
+        <% if page == @pagy.page %>
+          <span class="pagination__link pagination__link--current"><%= page %></span>
+        <% elsif page == :gap %>
+          <span class="pagination__link pagination__link--gap">...</span>
+        <% else %>
+          <%= link_to page, archives_path(page: page), class: "pagination__link", data: {turbo_frame: "_top"} %>
+        <% end %>
+      <% end %>
+
+      <% if @pagy.next %>
+        <%= link_to @pagy.next, archives_path(page: @pagy.next), class: "pagination__link pagination__link--next", data: {turbo_frame: "_top"} %>
+      <% end %>
+    </nav>
+  <% end %>
 </main>
