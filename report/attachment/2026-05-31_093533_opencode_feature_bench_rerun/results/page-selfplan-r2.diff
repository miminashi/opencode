diff --git a/app/assets/stylesheets/article.css b/app/assets/stylesheets/article.css
index 8e797a5..4606dc0 100644
--- a/app/assets/stylesheets/article.css
+++ b/app/assets/stylesheets/article.css
@@ -37,3 +37,42 @@
 .article__log pre {
   white-space: pre-wrap;
 }
+
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: var(--space-xs);
+  padding-top: var(--space-s);
+  padding-bottom: var(--space-s);
+}
+
+.pagination a,
+.pagination span {
+  display: inline-block;
+  padding: var(--space-xs) var(--space-s);
+  border: 1px solid #DDD;
+  border-radius: 4px;
+  text-decoration: none;
+  color: #333;
+}
+
+.pagination a:hover {
+  background-color: #F0F0F0;
+}
+
+.pagination .current span {
+  background-color: #333;
+  color: #FFF;
+  border-color: #333;
+}
+
+.pagination .prev,
+.pagination .next {
+  font-weight: bold;
+}
+
+.pagination .gap span {
+  border: none;
+  cursor: default;
+}
