diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..0d4958f
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,33 @@
+.pagination {
+  text-align: center;
+  padding: 20px 0;
+}
+
+.pagination .page,
+.pagination .current,
+.pagination .next,
+.pagination .prev,
+.pagination .gap {
+  display: inline-block;
+  margin: 0 4px;
+}
+
+.pagination a.page {
+  padding: 6px 12px;
+  border: 1px solid #ddd;
+  color: #0066cc;
+  text-decoration: none;
+  border-radius: 4px;
+}
+
+.pagination a.page:hover {
+  background-color: #f0f0f0;
+}
+
+.pagination .current {
+  padding: 6px 12px;
+  background-color: #0066cc;
+  color: white;
+  border: 1px solid #0066cc;
+  border-radius: 4px;
+}
