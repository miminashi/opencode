diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..a0a2733
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,37 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  padding: var(--space-m) 0;
+  gap: var(--space-xs);
+}
+
+.pagination .page {
+  display: inline-block;
+  padding: var(--space-xxs) var(--space-s);
+  border-radius: var(--border-radius);
+  text-decoration: none;
+  color: var(--color-dark);
+  font-weight: bold;
+  border: 1px solid var(--color-light);
+}
+
+.pagination .page:hover {
+  background-color: var(--color-light);
+}
+
+.pagination .page.current {
+  background-color: var(--color-primary);
+  color: var(--color-white);
+  border-color: var(--color-primary);
+}
+
+.pagination .page.prev,
+.pagination .page.next {
+  font-weight: bold;
+}
+
+.pagination .page.disabled {
+  opacity: 0.4;
+  pointer-events: none;
+}
diff --git a/app/controllers/archives_controller.rb b/app/controllers/archives_controller.rb
