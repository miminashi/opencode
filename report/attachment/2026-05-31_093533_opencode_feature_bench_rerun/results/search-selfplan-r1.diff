diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..2d23825 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,38 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search with nil query returns all archives" do
+    count_before = Archive.count
+    result = Archive.search(nil)
+    assert_equal count_before, result.count
+  end
+
+  test "search with empty query returns all archives" do
+    count_before = Archive.count
+    result = Archive.search("")
+    assert_equal count_before, result.count
+  end
+
+  test "search with matching query returns matching archives" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Elephants Dream")
+    result = Archive.search("Buck")
+    assert_equal 1, result.count
+    assert_equal archive1.id, result.first.id
+  end
+
+  test "search with non-matching query returns empty" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Elephants Dream")
+    result = Archive.search("NonExistent")
+    assert_equal 0, result.count
+  end
+
+  test "search returns partial match" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    result = Archive.search("Bunny")
+    assert_equal 1, result.count
+    assert_equal archive.id, result.first.id
+  end
 end
