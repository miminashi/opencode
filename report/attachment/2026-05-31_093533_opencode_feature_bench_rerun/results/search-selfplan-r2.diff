diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..fa90ec8 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,55 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope with matching query returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Sample Video")
+    Archive.create!(original_url: "https://vimeo.com/1084539", title: "Another Title")
+
+    results = Archive.search("Bunny")
+    assert_equal 1, results.count
+    assert_equal "Big Buck Bunny", results.first.title
+  end
+
+  test "search scope with partial match returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Bunny Tail Story")
+
+    results = Archive.search("Bunny")
+    assert_equal 2, results.count
+  end
+
+  test "search scope with empty query returns all archives" do
+    count_before = Archive.count
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video One")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Video Two")
+
+    assert_equal Archive.count, Archive.search("").count
+    assert_equal Archive.count, Archive.search(nil).count
+  end
+
+  test "search scope with no match returns empty results" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video One")
+
+    results = Archive.search("NonExistent")
+    assert_equal 0, results.count
+  end
+
+  test "search scope escapes special characters" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test%Video")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Normal Title")
+
+    results = Archive.search("%")
+    assert_equal 1, results.count
+    assert_equal "Test%Video", results.first.title
+  end
+
+  test "search scope is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+
+    assert_equal 1, Archive.search("bunny").count
+    assert_equal 1, Archive.search("BUNNY").count
+    assert_equal 1, Archive.search("Bunny").count
+  end
 end
