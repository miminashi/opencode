diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..7482788 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,38 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives by title" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python 入門講座")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1234567", title: "Docker 基礎")
+
+    result = Archive.search("Rails")
+    assert_equal 1, result.count
+    assert_includes result, archive1
+  end
+
+  test "search scope returns all archives when title is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "テスト動画1")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "テスト動画2")
+
+    result = Archive.search("")
+    assert result.count >= 2
+  end
+
+  test "search scope returns all archives when title is nil" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "テスト動画1")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "テスト動画2")
+
+    result = Archive.search(nil)
+    assert result.count >= 2
+  end
+
+  test "search scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python 入門")
+
+    result = Archive.search("Zebra")
+    assert_equal 0, result.count
+  end
 end
