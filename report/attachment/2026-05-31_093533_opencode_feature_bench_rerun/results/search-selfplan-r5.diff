--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -111,6 +111,40 @@ class ArchiveTest < ActiveSupport::TestCase
     assert_equal archives(:failed_archive).id, failed_archives.first.id
   end
 
+  test "scope by_title filters archives by title (partial match)" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Python Programming")
+    Archive.create!(original_url: "https://vimeo.com/3084537", title: "JavaScript Basics")
+
+    result = Archive.by_title("Ruby")
+    assert_equal 1, result.count
+    assert_equal "Ruby on Rails Tutorial", result.first.title
+
+    result2 = Archive.by_title("Programming")
+    assert_equal 1, result2.count
+    assert_equal "Python Programming", result2.first.title
+  end
+
+  test "scope by_title returns all when search is empty" do
+    count = Archive.count
+    result = Archive.by_title("")
+    assert_equal count, result.count
+    result2 = Archive.by_title(nil)
+    assert_equal count, result2.count
+  end
+
+  test "scope by_title is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+
+    result_lower = Archive.by_title("ruby")
+    assert_equal 1, result_lower.count
+    assert_equal "Ruby on Rails Tutorial", result_lower.first.title
+
+    result_upper = Archive.by_title("RUBY")
+    assert_equal 1, result_upper.count
+    assert_equal "Ruby on Rails Tutorial", result_upper.first.title
+  end
+
