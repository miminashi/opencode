diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..d08347e
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,41 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  padding: 20px 0;
+  gap: 4px;
+}
+
+.pagination nav {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+}
+
+.pagination a,
+.pagination span {
+  display: inline-block;
+  padding: 6px 12px;
+  border: 1px solid #ddd;
+  border-radius: 4px;
+  text-decoration: none;
+  color: #333;
+  font-size: 14px;
+}
+
+.pagination a:hover {
+  background-color: #f0f0f0;
+  border-color: #ccc;
+}
+
+.pagination .current {
+  background-color: #007bff;
+  border-color: #007bff;
+  color: #fff;
+  font-weight: bold;
+}
+
+.pagination .gap {
+  border: none;
+  color: #999;
+}
