diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..29e1c76 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,38 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Ruby 入門ガイド")
+    Archive.create!(original_url: "https://vimeo.com/9999999", title: "Python 解説")
+
+    results = Archive.search_by_title("Rails")
+    assert_equal 1, results.count
+    assert_equal "Ruby on Rails チュートリアル", results.first.title
+
+    results = Archive.search_by_title("Ruby")
+    assert_equal 2, results.count
+
+    results = Archive.search_by_title("python")
+    assert_equal 1, results.count
+    assert_equal "Python 解説", results.first.title
+  end
+
+  test "search_by_title returns all archives when query is blank" do
+    count_before = Archive.count
+
+    results = Archive.search_by_title("")
+    assert_equal count_before, results.count
+
+    results = Archive.search_by_title(nil)
+    assert_equal count_before, results.count
+  end
+
+  test "search_by_title returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+
+    results = Archive.search_by_title("Zzzz")
+    assert_equal 0, results.count
+  end
 end
