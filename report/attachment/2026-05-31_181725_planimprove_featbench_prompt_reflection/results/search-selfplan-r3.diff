diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..d49cfe7 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,57 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title scope finds matching archives by title" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Ruby 入門ガイド")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1199999", title: "Python 講座")
+
+    result = Archive.search_by_title("Ruby")
+    assert_equal 2, result.count
+    assert_includes result, archive1
+    assert_includes result, archive2
+  end
+
+  test "search_by_title scope is case insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+
+    result_lower = Archive.search_by_title("ruby")
+    result_upper = Archive.search_by_title("RUBY")
+    result_mixed = Archive.search_by_title("RuBy")
+
+    assert_equal 1, result_lower.count
+    assert_includes result_lower, archive
+    assert_equal 1, result_upper.count
+    assert_includes result_upper, archive
+    assert_equal 1, result_mixed.count
+    assert_includes result_mixed, archive
+  end
+
+  test "search_by_title scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+
+    result = Archive.search_by_title("Python")
+    assert_equal 0, result.count
+  end
+
+  test "search_by_title scope returns all when query is blank" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python 講座")
+
+    result_blank = Archive.search_by_title("")
+    result_nil = Archive.search_by_title(nil)
+
+    assert_includes result_blank, archive1
+    assert_includes result_blank, archive2
+    assert_includes result_nil, archive1
+    assert_includes result_nil, archive2
+  end
+
+  test "search_by_title scope returns all when query is whitespace" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+
+    result = Archive.search_by_title("   ")
+    assert_equal Archive.count, result.count
+  end
 end
