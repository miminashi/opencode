diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..d4df3a4 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,43 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Rubyチュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails入門")
+    Archive.create!(original_url: "https://vimeo.com/1184537", title: "RubyonRails解説")
+
+    searched = Archive.search("Ruby")
+    assert_equal 2, searched.count
+    assert_includes searched.map(&:title), "Rubyチュートリアル"
+    assert_includes searched.map(&:title), "RubyonRails解説"
+  end
+
+  test "search scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Rubyチュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails入門")
+
+    searched = Archive.search("Python")
+    assert_equal 0, searched.count
+  end
+
+  test "search scope with empty query returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Rubyチュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails入門")
+
+    searched = Archive.search("")
+    assert_equal Archive.count, searched.count
+  end
+
+  test "search scope is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Rubyチュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails入門")
+
+    searched_lower = Archive.search("ruby")
+    searched_upper = Archive.search("RUBY")
+    assert_equal 1, searched_lower.count
+    assert_equal 1, searched_upper.count
+    assert_includes searched_lower.map(&:title), "Rubyチュートリアル"
+    assert_includes searched_upper.map(&:title), "Rubyチュートリアル"
+  end
 end
