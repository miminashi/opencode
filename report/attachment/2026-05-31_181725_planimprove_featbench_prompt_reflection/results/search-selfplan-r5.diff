--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,35 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should filter archives by title search query" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Rubyチュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails入門")
+
+    get archives_url, params: { q: "Ruby" }
+    assert_response :success
+    assert_select "h2.article__title", text: "Rubyチュートリアル"
+    assert_select "h2.article__title", count: 1
+  end
+
+  test "should return all archives when search query is empty" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Rubyチュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails入門")
+
+    total_count = Archive.count
+    get archives_url, params: { q: "" }
+    assert_response :success
+    assert_select "h2.article__title", count: total_count
+  end
+
+  test "search is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Rubyチュートリアル")
+
+    get archives_url, params: { q: "ruby" }
+    assert_response :success
+    assert_select "h2.article__title", text: "Rubyチュートリアル"
+    assert_select "h2.article__title", count: 1
+  end
+
