diff --git a/app/assets/stylesheets/article.css b/app/assets/stylesheets/article.css
index 8e797a5..a2a1e2e 100644
--- a/app/assets/stylesheets/article.css
+++ b/app/assets/stylesheets/article.css
@@ -37,3 +37,29 @@
 .article__log pre {
   white-space: pre-wrap;
 }
+
+.pagination {
+  display: flex;
+  justify-content: center;
+  gap: var(--space-xs);
+  margin-top: var(--space-m);
+}
+
+.pagination a,
+.pagination span {
+  padding: var(--space-xs) var(--space-s);
+  border: 1px solid #ddd;
+  border-radius: 4px;
+  text-decoration: none;
+  color: #333;
+}
+
+.pagination a:hover {
+  background-color: #f0f0f0;
+}
+
+.pagination .current {
+  background-color: #333;
+  color: #fff;
+  border-color: #333;
+}
