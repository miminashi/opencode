diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..e0ef4c5 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,27 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title scope returns matching archives by partial title match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Rubyチュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails入門")
+    Archive.create!(original_url: "https://vimeo.com/1234567", title: "RubyonRails")
+
+    result = Archive.search_by_title("Ruby")
+    assert_equal 2, result.count
+
+    result2 = Archive.search_by_title("チュートリアル")
+    assert_equal 1, result2.count
+
+    result3 = Archive.search_by_title("Python")
+    assert_equal 0, result3.count
+  end
+
+  test "search_by_title scope returns all when query is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "テスト動画1")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "テスト動画2")
+
+    result = Archive.search_by_title("")
+    assert_equal Archive.count, result.count
+  end
 end
