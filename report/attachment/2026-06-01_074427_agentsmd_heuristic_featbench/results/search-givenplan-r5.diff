     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should filter archives by title with q parameter" do
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1234567", title: "React とは")
+    get archives_url, params: { q: "Rails" }
+    assert_response :success
+    assert_includes response.body, "Ruby on Rails チュートリアル"
+    assert_not_includes response.body, "React とは"
+  end
+
+  test "should return all archives when q parameter is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Ruby on Rails チュートリアル")
+    get archives_url, params: { q: "" }
+    assert_response :success
+  end
