diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..2d6c6a5 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,30 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Ruby 入門ガイド")
+    Archive.create!(original_url: "https://vimeo.com/1234567", title: "React とは")
+    result = Archive.search_by_title("Rails")
+    assert_equal 1, result.count
+    assert_includes result, archive1
+    result2 = Archive.search_by_title("Ruby")
+    assert_equal 2, result2.count
+    assert_includes result2, archive1
+    assert_includes result2, archive2
+  end
+
+  test "search_by_title returns empty for non-matching query" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    result = Archive.search_by_title("Python")
+    assert_equal 0, result.count
+  end
+
+  test "search_by_title returns all when query is blank" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video One")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video Two")
+    result = Archive.search_by_title("")
+    assert_equal Archive.count, result.count
+  end
 end
