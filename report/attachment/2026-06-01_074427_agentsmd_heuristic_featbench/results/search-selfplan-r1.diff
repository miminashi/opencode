diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..ec924b2 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,40 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should search archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "検索テスト動画")
+    get archives_url, params: { q: "検索" }
+    assert_response :success
+    assert_select "article", count: 1
+  end
+
+  test "should return empty when no match" do
+    get archives_url, params: { q: "存在しないタイトル" }
+    assert_response :success
+    assert_select "article", count: 0
+  end
+
+  test "should search case-insensitively" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "大文字小文字テスト")
+    get archives_url, params: { q: "大文字" }
+    assert_response :success
+    assert_select "article", count: 1
+  end
+
+  test "should show all archives when no search query" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "テスト動画A")
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "テスト動画B")
+    count_before = Archive.count
+    get archives_url
+    assert_response :success
+    assert_select "article", count: count_before
+  end
+
+  test "should return empty when search query is blank" do
+    get archives_url, params: { q: "" }
+    assert_response :success
+  end
+
