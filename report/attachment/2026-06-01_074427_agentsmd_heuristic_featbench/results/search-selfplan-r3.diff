diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..e80b267 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,45 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "searched scope with matching query returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python Programming")
+    matched = Archive.searched("Rails")
+    assert_equal 1, matched.count
+    assert_equal "Ruby on Rails Tutorial", matched.first.title
+  end
+
+  test "searched scope is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    matched_upper = Archive.searched("RUBY")
+    assert_equal 1, matched_upper.count
+    matched_lower = Archive.searched("ruby")
+    assert_equal 1, matched_lower.count
+    assert_equal "Ruby on Rails Tutorial", matched_lower.first.title
+  end
+
+  test "searched scope with partial match returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Cool Story Time")
+    matched = Archive.searched("Buck")
+    assert_equal 1, matched.count
+    assert_equal "Big Buck Bunny", matched.first.title
+  end
+
+  test "searched scope with non-matching query returns empty collection" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video")
+    matched = Archive.searched("存在しないタイトル")
+    assert_equal 0, matched.count
+  end
+
+  test "searched scope with empty string returns all archives" do
+    matched = Archive.searched("")
+    assert_equal Archive.count, matched.count
+  end
+
+  test "searched scope with nil returns all archives" do
+    matched = Archive.searched(nil)
+    assert_equal Archive.count, matched.count
+  end
 end
