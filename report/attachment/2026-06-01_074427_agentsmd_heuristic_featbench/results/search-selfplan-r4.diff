diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..2d3b8f8 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,43 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search returns matching archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Docker 入門ガイド")
+    Archive.create!(original_url: "https://vimeo.com/1234567", title: "Ruby プロジェクト")
+
+    results = Archive.search("Rails")
+    assert_equal 1, results.count
+    assert_equal "Ruby on Rails チュートリアル", results.first.title
+  end
+
+  test "search is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails")
+
+    results_upper = Archive.search("RUBY")
+    assert_equal 1, results_upper.count
+
+    results_lower = Archive.search("rails")
+    assert_equal 1, results_lower.count
+  end
+
+  test "search returns all when query is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video One")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video Two")
+
+    count_before = Archive.count
+    results = Archive.search("")
+    assert_equal count_before, results.count
+
+    results_nil = Archive.search(nil)
+    assert_equal count_before, results_nil.count
+  end
+
+  test "search returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails")
+
+    results = Archive.search(" nonexistent title ")
+    assert_equal 0, results.count
+  end
 end
