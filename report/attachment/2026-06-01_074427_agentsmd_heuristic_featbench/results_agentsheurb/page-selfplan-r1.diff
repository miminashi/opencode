diff --git a/test/integration/archive_creation_flow_test.rb b/test/integration/archive_creation_flow_test.rb
index fab2640..2396a36 100644
--- a/test/integration/archive_creation_flow_test.rb
+++ b/test/integration/archive_creation_flow_test.rb
@@ -37,4 +37,40 @@ class ArchiveCreationFlowTest < ActionDispatch::IntegrationTest
     assert_select "h2", "Test Video"
     assert_select "a[href=?]", archive.original_url
   end
+
+  test "should paginate archives with more than 20 items" do
+    # Clear existing archives to have full control over count
+    Archive.delete_all
+
+    # Create 25 archives (more than one page of 20)
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{1084537 + i}", title: "Paginated Video #{i + 1}")
+    end
+
+    # First page should show exactly 20 items
+    get archives_url
+    assert_response :success
+    assert_select "article.article", 20
+    assert_select "div.pagination"
+  end
+
+  test "should navigate to second page" do
+    # Clear existing archives
+    Archive.delete_all
+
+    # Create 25 archives
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{1084537 + i}", title: "Page Test Video #{i + 1}")
+    end
+
+    # First page shows 20 items
+    get archives_url
+    assert_response :success
+    assert_select "article.article", 20
+
+    # Second page shows remaining 5 items
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert_select "article.article", 5
+  end
 end
