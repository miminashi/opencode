diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..29fd3a2 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,46 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives - page 1 shows 20 items" do
+    Archive.delete_all
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{1084537 + i}")
+    end
+    get archives_url, params: { page: "1" }
+    assert_response :success
+    assert_select "article.article", 20
+  end
+
+  test "should paginate archives - page 2 shows remaining items" do
+    Archive.delete_all
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{2084537 + i}")
+    end
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert_select "article.article", 5
+  end
+
+  test "should paginate archives - less than one page shows all" do
+    Archive.delete_all
+    15.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{3084537 + i}")
+    end
+    get archives_url, params: { page: "1" }
+    assert_response :success
+    assert_select "article.article", 15
+  end
+
+  test "should paginate archives - empty page renders without articles" do
+    Archive.delete_all
+    5.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{4084537 + i}")
+    end
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert_select "article.article", 0
+  end
+
