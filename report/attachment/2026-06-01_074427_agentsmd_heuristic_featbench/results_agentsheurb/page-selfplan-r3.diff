diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..c05183f 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,20 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives on index" do
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/1084537", title: "Pagination Test #{i}")
+    end
+
+    get archives_url
+    assert_response :success
+    assert_not_nil @controller.instance_variable_get(:@archives)
+    archives = @controller.instance_variable_get(:@archives)
+    assert_respond_to archives, :total_pages
+    assert_equal 2, archives.total_pages
+    assert_equal 20, archives.size
+  end
+
