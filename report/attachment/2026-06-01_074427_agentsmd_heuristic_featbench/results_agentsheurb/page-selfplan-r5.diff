diff --git a/test/system/archives_test.rb b/test/system/archives_test.rb
index 9751efc..8c59018 100644
--- a/test/system/archives_test.rb
+++ b/test/system/archives_test.rb
@@ -38,4 +38,20 @@ class ArchivesTest < ApplicationSystemTestCase
     assert_selector "h1", text: "保存したビデオ"
     assert_text "test_10s.mov"
   end
+
+  test "ページネーションが表示される" do
+    # Create 25 archives to exceed the per-page limit of 20
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/pagination/#{i}", status: "waiting")
+    end
+
+    visit archives_path
+
+    # First page should show exactly 20 items
+    all_articles = find_all("article.article")
+    assert_equal 20, all_articles.length
+
+    # Pagination controls should be present
+    assert_selector ".pagination"
+  end
 end
