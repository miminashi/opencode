diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..8bad725 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,24 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives with more than 20 items" do
+    # Create 25 archives (fixtures=4 + setup=1 + test=25 = 30 total)
+    # to exceed the per-page limit of 20
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/test/#{i}", status: "waiting")
+    end
+
+    # First page should return exactly 20 items
+    get archives_url
+    assert_response :success
+    assert_select "article.article", count: 20
+
+    # Second page should exist with remaining items (30 - 20 = 10)
+    get archives_url, params: { page: 2 }
+    assert_response :success
+    assert_select "article.article", count: 10
+  end
+
