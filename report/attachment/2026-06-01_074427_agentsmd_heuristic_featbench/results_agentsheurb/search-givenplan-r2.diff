diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..ad2a0e4 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,30 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title matches partial title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    results = Archive.search_by_title("Ruby")
+    assert results.any? { |a| a.title == "Ruby on Rails Tutorial" }
+  end
+
+  test "search_by_title does not match non-existent title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    results = Archive.search_by_title("nonexistent")
+    assert_empty results
+  end
+
+  test "search_by_title with empty query returns all archives" do
+    count = Archive.count
+    results = Archive.search_by_title("")
+    assert_equal count, results.count
+  end
+
+  test "search_by_title is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    results_lower = Archive.search_by_title("ruby")
+    results_upper = Archive.search_by_title("RUBY")
+    assert results_lower.any? { |a| a.title == "Ruby on Rails Tutorial" }
+    assert results_upper.any? { |a| a.title == "Ruby on Rails Tutorial" }
+  end
 end
