@@ -62,6 +62,20 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "index with q parameter filters archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    get archives_url, params: { q: "Ruby" }
+    assert_response :success
+    assert_includes response.body, "Ruby on Rails Tutorial"
+  end
+
+  test "index with non-matching q parameter returns no matching results" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    get archives_url, params: { q: "nonexistentvideo" }
+    assert_response :success
+    assert_not_includes response.body, "Ruby on Rails Tutorial"
+  end
+
