diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..2cbe9e7 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,52 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should search archives by title - partial match" do
+    get archives_url, params: { q: "Ruby" }
+    assert_response :success
+    response_body = response.body
+    assert_includes response_body, "Ruby Tutorial Part 1"
+    assert_includes response_body, "Ruby Tutorial Part 2"
+    assert_includes response_body, "Ruby Tutorial Advanced"
+    assert_not_includes response_body, "Rails Guide"
+  end
+
+  test "should search archives by title - case insensitive" do
+    get archives_url, params: { q: "ruby" }
+    assert_response :success
+    response_body = response.body
+    assert_includes response_body, "Ruby Tutorial Part 1"
+    assert_includes response_body, "Ruby Tutorial Part 2"
+    assert_includes response_body, "Ruby Tutorial Advanced"
+  end
+
+  test "should return all archives when query is empty" do
+    get archives_url, params: { q: "" }
+    assert_response :success
+    response_body = response.body
+    assert_includes response_body, "Waiting Video"
+    assert_includes response_body, "Done Video"
+    assert_includes response_body, "Failed Video"
+    assert_includes response_body, "Processing Video"
+    assert_includes response_body, "Ruby Tutorial Part 1"
+  end
+
+  test "should return no results when query has no match" do
+    get archives_url, params: { q: "zzzzz_nomatch_zzzzz" }
+    assert_response :success
+    response_body = response.body
+    assert_not_includes response_body, "Waiting Video"
+    assert_not_includes response_body, "Ruby Tutorial Part 1"
+  end
+
+  test "should search archives by title - single word match" do
+    get archives_url, params: { q: "Rails" }
+    assert_response :success
+    response_body = response.body
+    assert_includes response_body, "Rails Guide"
+    assert_not_includes response_body, "Ruby Tutorial Part 1"
+  end
+
