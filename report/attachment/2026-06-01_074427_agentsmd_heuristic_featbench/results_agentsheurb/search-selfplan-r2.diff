diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..ac156c6 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -111,6 +111,52 @@ class ArchiveTest < ActiveSupport::TestCase
     assert_equal archives(:failed_archive).id, failed_archives.first.id
   end
 
+  test "search scope with matching query returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Another Video")
+    Archive.create!(original_url: "https://vimeo.com/1182937", title: "No Match Here")
+
+    results = Archive.search("Test")
+    assert_equal 1, results.count
+    assert_includes results.pluck(:title), "Test Video"
+  end
+
+  test "search scope with non-matching query returns empty" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Another Video")
+
+    results = Archive.search("xyznonexistent")
+    assert_equal 0, results.count
+  end
+
+  test "search scope with blank query returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video A")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video B")
+
+    results = Archive.search("")
+    assert results.count >= 2
+  end
+
+  test "search scope is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video")
+
+    assert_equal Archive.search("test").count, Archive.search("TEST").count
+    assert_equal Archive.search("test").count, Archive.search("Test").count
+  end
+
+  test "search scope performs partial match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "My Favorite Video")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video Game Review")
+
+    results = Archive.search("Favorite")
+    assert_equal 1, results.count
+    assert_equal "My Favorite Video", results.first.title
+
+    results = Archive.search("Game")
+    assert_equal 1, results.count
+    assert_equal "Video Game Review", results.first.title
+  end
+
   test "before_save callback sets default title" do
     archive = Archive.new(original_url: "https://vimeo.com/1084537")
     archive.save!
