diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..102dbce 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,52 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "index with search query returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Search Test Video")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Another Video")
+
+    get archives_url, params: { q: "Search Test" }
+    assert_response :success
+    assert_includes response.body, "Search Test Video"
+    assert_not_includes response.body, "Another Video"
+  end
+
+  test "index with search query is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Case Sensitive Video")
+
+    get archives_url, params: { q: "case sensitive" }
+    assert_response :success
+    assert_includes response.body, "Case Sensitive Video"
+
+    get archives_url, params: { q: "CASE SENSITIVE" }
+    assert_response :success
+    assert_includes response.body, "Case Sensitive Video"
+  end
+
+  test "index with non-matching search query returns empty results" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Some Video")
+
+    get archives_url, params: { q: "xyznonexistent" }
+    assert_response :success
+    assert_not_includes response.body, "Some Video"
+  end
+
+  test "index with blank search query returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video A")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video B")
+
+    get archives_url, params: { q: "" }
+    assert_response :success
+  end
+
+  test "index without search query returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video A")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video B")
+
+    get archives_url
+    assert_response :success
+  end
+
