diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..5618b74 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,49 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives by title" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video A")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1084538", title: "Test Video B")
+    Archive.create!(original_url: "https://vimeo.com/1084539", title: "Other Title")
+
+    result = Archive.search("Test")
+    assert_equal 2, result.count
+    assert_includes result, archive1
+    assert_includes result, archive2
+  end
+
+  test "search scope is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "another video")
+
+    result_lower = Archive.search("test")
+    result_upper = Archive.search("TEST")
+    result_mixed = Archive.search("TeSt")
+
+    assert_equal 1, result_lower.count
+    assert_equal 1, result_upper.count
+    assert_equal 1, result_mixed.count
+  end
+
+  test "search scope with empty query returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video A")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Video B")
+    total = Archive.count
+
+    result_nil = Archive.search(nil)
+    result_empty = Archive.search("")
+
+    assert_equal total, result_nil.count
+    assert_equal total, result_empty.count
+  end
+
+  test "search scope with no matches returns empty collection" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video A")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Video B")
+
+    result = Archive.search("zzz_nonexistent_zzz")
+    assert_equal 0, result.count
+    assert_empty result
+  end
 end
