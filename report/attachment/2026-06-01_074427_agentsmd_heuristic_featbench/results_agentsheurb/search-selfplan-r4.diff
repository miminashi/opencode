diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..05b23e5 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,36 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives by partial title match" do
+    matching = Archive.search("Ruby")
+    assert_equal 2, matching.count
+    assert_includes matching.map(&:title), "Ruby Tutorial for Beginners"
+    assert_includes matching.map(&:title), "Ruby on Rails Full Course"
+  end
+
+  test "search scope returns all archives when query is blank" do
+    all_with_search = Archive.search("")
+    all_without_search = Archive.all
+    assert_equal all_without_search.count, all_with_search.count
+  end
+
+  test "search scope is case insensitive" do
+    upper = Archive.search("RUBY")
+    lower = Archive.search("ruby")
+    assert_equal upper.count, lower.count
+    assert_equal upper.map(&:id).sort, lower.map(&:id).sort
+  end
+
+  test "search scope returns no results for non-matching query" do
+    non_matching = Archive.search("非-existent-keyword-xyz")
+    assert_equal 0, non_matching.count
+  end
+
+  test "search scope works with ordered scope" do
+    ordered_search = Archive.ordered.search("Ruby")
+    assert_equal 2, ordered_search.count
+    ids = ordered_search.pluck(:id)
+    assert_equal ids, ids.sort.reverse
+  end
 end
