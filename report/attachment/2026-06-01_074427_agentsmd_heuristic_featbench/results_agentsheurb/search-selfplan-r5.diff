diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..1ad49bf 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,56 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python 入門講座")
+    Archive.create!(original_url: "https://vimeo.com/1184537", title: "Rails で Web アプリ開発")
+
+    results = Archive.search("rails")
+    assert_equal 2, results.count
+    assert_includes results.pluck(:title), "Ruby on Rails チュートリアル"
+    assert_includes results.pluck(:title), "Rails で Web アプリ開発"
+  end
+
+  test "search scope is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python 入門講座")
+
+    results_upper = Archive.search("RAILS")
+    results_lower = Archive.search("rails")
+    assert_equal 1, results_upper.count
+    assert_equal 1, results_lower.count
+    assert_equal results_upper.first.id, results_lower.first.id
+  end
+
+  test "search scope with empty keyword returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "動画 A")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "動画 B")
+    Archive.create!(original_url: "https://vimeo.com/1184537", title: "動画 C")
+
+    all_count = Archive.count
+    results_blank = Archive.search("")
+    results_nil = Archive.search(nil)
+    assert_equal all_count, results_blank.count
+    assert_equal all_count, results_nil.count
+  end
+
+  test "search scope returns empty result when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python 入門講座")
+
+    results = Archive.search(" nonexistent keyword ")
+    assert_equal 0, results.count
+  end
+
+  test "search scope chains with ordered scope" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Rails 入門")
+    sleep 0.1
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails 応用")
+
+    results = Archive.search("rails").ordered
+    assert_equal 2, results.count
+    assert_equal archive2.id, results.first.id
+  end
 end
