diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..0d52069 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,25 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives on first page" do
+    get archives_url
+    assert_response :success
+    assert_equal 20, assigns(:archives).count
+  end
+
+  test "should show second page of archives" do
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert assigns(:archives).count < 20
+    assert assigns(:archives).count > 0
+  end
+
+  test "should render pagination helper" do
+    get archives_url
+    assert_response :success
+    assert_select "nav"
+  end
+
