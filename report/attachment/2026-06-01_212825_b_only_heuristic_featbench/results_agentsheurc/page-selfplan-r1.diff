diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..21d09b2 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,28 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives on index page" do
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/pagination/#{i}", status: Archive::Status::DONE)
+    end
+
+    get archives_url
+    assert_response :success
+    assert_equal 20, assigns(:archives).size
+    assert_equal true, assigns(:archives).current_page != assigns(:archives).total_pages
+  end
+
+  test "should show second page of archives" do
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/pagination/#{i}", status: Archive::Status::DONE)
+    end
+
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert_equal 10, assigns(:archives).size
+    assert_equal 2, assigns(:archives).current_page
+  end
+
