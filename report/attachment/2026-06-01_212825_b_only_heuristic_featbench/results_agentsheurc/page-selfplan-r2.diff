diff --git a/test/integration/archive_creation_flow_test.rb b/test/integration/archive_creation_flow_test.rb
index fab2640..53771ed 100644
--- a/test/integration/archive_creation_flow_test.rb
+++ b/test/integration/archive_creation_flow_test.rb
@@ -37,4 +37,16 @@ class ArchiveCreationFlowTest < ActionDispatch::IntegrationTest
     assert_select "h2", "Test Video"
     assert_select "a[href=?]", archive.original_url
   end
+
+  test "should paginate archives with more than 20 records" do
+    21.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{1000000 + i}", title: "Paginated Video #{i + 1}")
+    end
+
+    get archives_url
+    assert_response :success
+
+    assert_select ".pagination"
+    assert_select "a[aria-label='Next']"
+  end
 end
