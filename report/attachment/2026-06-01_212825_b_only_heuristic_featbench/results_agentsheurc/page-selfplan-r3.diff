@@ -15,6 +15,34 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "should paginate with 20 items per page" do
+    # Create 25 archives to test pagination (more than one page)
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/test#{i}", title: "Paginated Video #{i}")
+    end
+
+    get archives_url
+    assert_response :success
+
+    # Check that the response contains pagy variables
+    assert_select "nav.pagination"
+  end
+
+  test "should show second page when there are more than 20 records" do
+    # Create 25 archives to ensure we have at least 2 pages
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/paginate#{i}", title: "Pagination Test #{i}")
+    end
+
+    # First page
+    get archives_url, params: { page: "1" }
+    assert_response :success
+
+    # Second page
+    get archives_url, params: { page: "2" }
+    assert_response :success
+  end
