diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..031751d
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,50 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: var(--space-xs);
+  padding: var(--space-m) 0;
+}
+
+.pagination .pagy {
+  display: flex;
+  align-items: center;
+  gap: var(--space-xs);
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.pagination .pagy a,
+.pagination .pagy span {
+  display: inline-block;
+  padding: var(--space-xxs) var(--space-s);
+  border-radius: var(--border-radius);
+  text-decoration: none;
+  font-size: 0.9rem;
+}
+
+.pagination .pagy a {
+  color: var(--color-dark);
+  background-color: var(--color-light);
+  border: 1px solid var(--color-light);
+  cursor: pointer;
+  transition: background-color 0.2s, color 0.2s;
+}
+
+.pagination .pagy a:hover {
+  background-color: var(--color-primary);
+  color: var(--color-white);
+}
+
+.pagination .pagy .current {
+  background-color: var(--color-primary);
+  color: var(--color-white);
+  font-weight: bold;
+}
+
+.pagination .pagy .disabled {
+  color: var(--color-text-muted);
+  background-color: var(--color-light);
+  cursor: default;
+}
