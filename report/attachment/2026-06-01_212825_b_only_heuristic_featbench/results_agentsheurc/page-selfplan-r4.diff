diff --git a/test/system/archives_test.rb b/test/system/archives_test.rb
index 9751efc..efd8403 100644
--- a/test/system/archives_test.rb
+++ b/test/system/archives_test.rb
@@ -38,4 +38,31 @@ class ArchivesTest < ApplicationSystemTestCase
     assert_selector "h1", text: "保存したビデオ"
     assert_text "test_10s.mov"
   end
+
+  test "ページネーションが表示される" do
+    perform_enqueued_jobs do
+      21.times do |i|
+        Archive.create!(original_url: "https://vimeo.com/#{1000000 + i}", title: "Paginated Video #{i + 1}")
+      end
+    end
+
+    visit archives_path
+
+    assert_selector ".pagination"
+    assert_text "次へ"
+  end
+
+  test "ページネーションで2ページ目に遷移できる" do
+    perform_enqueued_jobs do
+      25.times do |i|
+        Archive.create!(original_url: "https://vimeo.com/#{2000000 + i}", title: "Page2 Video #{i + 1}")
+      end
+    end
+
+    visit archives_path
+
+    click_on "次へ"
+
+    assert_selector ".pagination"
+  end
 end
