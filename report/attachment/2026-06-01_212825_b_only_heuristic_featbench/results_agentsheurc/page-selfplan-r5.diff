diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..49f18dd 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,53 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives with more than 20 items" do
+    # Create 25 archives to test pagination (more than 20 per page)
+    25.times do |i|
+      archive = Archive.new(original_url: "https://example.com/video/#{i}")
+      archive.save!
+    end
+
+    get archives_url
+    assert_response :success
+
+    # First page should contain first 20 items (IDs 26-45 minus the setup archive)
+    # Verify pagination is present
+    assert_includes response.body, "rel=\"next\""
+    assert_includes response.body, "class=\"page current\""
+  end
+
+  test "should show second page when page param is specified" do
+    # Create 25 archives
+    25.times do |i|
+      archive = Archive.new(original_url: "https://example.com/paginated/#{i}")
+      archive.save!
+    end
+
+    get archives_url, params: { page: "2" }
+    assert_response :success
+
+    # Second page should exist with prev link and current page indicator showing 2
+    assert_includes response.body, "rel=\"prev\""
+    assert_includes response.body, "class=\"page current\""
+    assert_match %r{<span class="page current">\s*2\s*</span>}, response.body
+  end
+
+  test "should not show pagination when all items fit on one page" do
+    # Clear existing archives and create only 5 (less than 20)
+    Archive.delete_all
+    5.times do |i|
+      archive = Archive.new(original_url: "https://example.com/less/#{i}")
+      archive.save!
+    end
+
+    get archives_url
+    assert_response :success
+
+    # No pagination links should be present
+    assert_not_includes response.body, "class=\"page current\""
+  end
+
