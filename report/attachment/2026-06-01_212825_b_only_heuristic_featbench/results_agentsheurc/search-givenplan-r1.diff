diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..b72f5fd 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,28 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title scope returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails 7 Deep Dive")
+    Archive.create!(original_url: "https://vimeo.com/1182937", title: "Python Basics")
+
+    result = Archive.search_by_title("Rails")
+    assert_equal 2, result.count
+    assert_includes result.map(&:title), "Ruby on Rails Tutorial"
+    assert_includes result.map(&:title), "Rails 7 Deep Dive"
+  end
+
+  test "search_by_title scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails 7 Deep Dive")
+
+    result = Archive.search_by_title("Python")
+    assert_equal 0, result.count
+  end
+
+  test "search_by_title scope returns all when q is blank" do
+    result = Archive.search_by_title("")
+    assert_equal Archive.count, result.count
+  end
 end
