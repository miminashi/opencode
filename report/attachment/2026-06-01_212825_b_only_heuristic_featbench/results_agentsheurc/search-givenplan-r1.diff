diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..af3b549 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,26 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "index with q parameter filters archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/2132937", title: "Rails 7 Deep Dive")
+    Archive.create!(original_url: "https://vimeo.com/2182937", title: "Python Basics")
+
+    get archives_url, params: { q: "Rails" }
+    assert_response :success
+    # Should only return archives with "Rails" in the title (2 results)
+    assert_select "h2", count: 2
+  end
+
+  test "index with q parameter returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/2132937", title: "Rails 7 Deep Dive")
+
+    get archives_url, params: { q: "NonExistentTitle" }
+    assert_response :success
+    assert_select "h2", count: 0
+  end
+
