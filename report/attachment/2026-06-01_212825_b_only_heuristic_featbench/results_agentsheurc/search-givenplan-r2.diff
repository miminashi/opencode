diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..4955c6d 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,38 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "index with q parameter filters archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/2084538", title: "Python Programming")
+    Archive.create!(original_url: "https://vimeo.com/2084539", title: "Rails API Guide")
+
+    get archives_url, params: { q: "Rails" }
+    assert_response :success
+    assert_match(/Ruby on Rails Tutorial/, response.body)
+    assert_match(/Rails API Guide/, response.body)
+    assert_no_match(/Python Programming/, response.body)
+  end
+
+  test "index with q parameter returns all archives when query is empty" do
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/2084538", title: "Python Programming")
+
+    get archives_url, params: { q: "" }
+    assert_response :success
+    assert_match(/Ruby on Rails Tutorial/, response.body)
+    assert_match(/Python Programming/, response.body)
+  end
+
+  test "index with q parameter returns no matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/2084538", title: "Python Programming")
+
+    get archives_url, params: { q: "zzznonexistentzzz" }
+    assert_response :success
+    assert_no_match(/Ruby on Rails Tutorial/, response.body)
+    assert_no_match(/Python Programming/, response.body)
+  end
+
