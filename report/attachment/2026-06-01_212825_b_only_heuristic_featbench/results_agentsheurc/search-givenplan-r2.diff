diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..219ebf6 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,48 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives with partial match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Python Programming")
+    Archive.create!(original_url: "https://vimeo.com/1084539", title: "Rails API Guide")
+
+    results = Archive.search_by_title("Rails")
+    assert_equal 2, results.count
+    assert_includes results.pluck(:title), "Ruby on Rails Tutorial"
+    assert_includes results.pluck(:title), "Rails API Guide"
+  end
+
+  test "search_by_title returns no results for non-matching query" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Python Programming")
+
+    results = Archive.search_by_title("zzznonexistentzzz")
+    assert_equal 0, results.count
+  end
+
+  test "search_by_title returns all archives when query is empty" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video One")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Test Video Two")
+
+    results = Archive.search_by_title("")
+    assert_equal Archive.count, results.count
+  end
+
+  test "search_by_title returns all archives when query is nil" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video One")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Test Video Two")
+
+    results = Archive.search_by_title(nil)
+    assert_equal Archive.count, results.count
+  end
+
+  test "search_by_title is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Python Programming")
+
+    results = Archive.search_by_title("ruby")
+    assert_equal 1, results.count
+    assert_equal "Ruby on Rails Tutorial", results.first.title
+  end
 end
