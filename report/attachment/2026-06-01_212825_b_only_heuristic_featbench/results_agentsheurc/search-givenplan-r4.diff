diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..8075313 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,44 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives with partial match" do
+    Archive.delete_all
+    ruby_tutorial = Archive.create!(original_url: "https://vimeo.com/1001", title: "SearchTest Ruby on Rails チュートリアル")
+    ruby_intro = Archive.create!(original_url: "https://vimeo.com/1002", title: "SearchTest Ruby 入門講座")
+    javascript = Archive.create!(original_url: "https://vimeo.com/1003", title: "SearchTest JavaScript 基礎")
+
+    result = Archive.search_by_title("Ruby")
+    assert_equal 2, result.count
+    assert_includes result, ruby_tutorial
+    assert_includes result, ruby_intro
+  end
+
+  test "search_by_title returns no results when no match" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/2001", title: "SearchTest Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/2002", title: "SearchTest JavaScript 基礎")
+
+    result = Archive.search_by_title("Python")
+    assert_equal 0, result.count
+  end
+
+  test "search_by_title returns all archives when query is empty" do
+    Archive.delete_all
+    archive1 = Archive.create!(original_url: "https://vimeo.com/3001", title: "SearchTest Video 1")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/3002", title: "SearchTest Video 2")
+
+    result = Archive.search_by_title("")
+    assert_equal Archive.count, result.count
+  end
+
+  test "search_by_title is case insensitive" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/4001", title: "SearchTest Ruby on Rails チュートリアル")
+
+    result_lower = Archive.search_by_title("ruby")
+    result_upper = Archive.search_by_title("RUBY")
+    assert_equal 1, result_lower.count
+    assert_equal 1, result_upper.count
+  end
 end
