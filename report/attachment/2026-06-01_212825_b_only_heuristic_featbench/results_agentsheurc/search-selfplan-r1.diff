diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..7d5e8ec 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -111,6 +111,34 @@ class ArchiveTest < ActiveSupport::TestCase
     assert_equal archives(:failed_archive).id, failed_archives.first.id
   end
 
+  test "search_by_title with matching query returns filtered results" do
+    matching = Archive.search_by_title("Hello")
+    assert_equal 2, matching.count
+  end
+
+  test "search_by_title with non-matching query returns empty" do
+    non_matching = Archive.search_by_title("zzzzznonexistentzzzzz")
+    assert_equal 0, non_matching.count
+  end
+
+  test "search_by_title with empty string returns all archives" do
+    all_archives = Archive.search_by_title("")
+    assert_equal Archive.count, all_archives.count
+  end
+
+  test "search_by_title is case-insensitive" do
+    lower = Archive.search_by_title("hello")
+    upper = Archive.search_by_title("HELLO")
+    original = Archive.search_by_title("Hello")
+    assert_equal original.count, lower.count
+    assert_equal original.count, upper.count
+  end
+
+  test "search_by_title supports partial matching" do
+    partial = Archive.search_by_title("アニメ")
+    assert_equal 2, partial.count
+  end
+
   test "before_save callback sets default title" do
     archive = Archive.new(original_url: "https://vimeo.com/1084537")
     archive.save!
diff --git a/test/system/archives_test.rb b/test/system/archives_test.rb
index 9751efc..1fc4f97 100644
--- a/test/system/archives_test.rb
+++ b/test/system/archives_test.rb
@@ -38,4 +38,38 @@ class ArchivesTest < ApplicationSystemTestCase
     assert_selector "h1", text: "保存したビデオ"
     assert_text "test_10s.mov"
   end
+
+  test "タイトル検索でフィルタリングできる" do
+    visit archives_path
+
+    fill_in "タイトルで検索...", with: "Hello"
+    click_on "検索"
+
+    assert_selector "h1", text: "保存したビデオ"
+    assert_text "Hello World Tutorial"
+    assert_text "Hello Ruby on Rails"
+  end
+
+  test "検索結果がない場合は空のリストが表示される" do
+    visit archives_path
+
+    fill_in "タイトルで検索...", with: "zzzzznonexistentzzzzz"
+    click_on "検索"
+
+    assert_selector "h1", text: "保存したビデオ"
+    assert_no_text "Hello World Tutorial"
+  end
+
+  test "検索クリアで全件表示に戻る" do
+    visit archives_path
+
+    fill_in "タイトルで検索...", with: "Hello"
+    click_on "検索"
+
+    assert_text "Hello World Tutorial"
+
+    click_on "クリア"
+
+    assert_selector "h1", text: "保存したビデオ"
+  end
 end
