+    assert_equal 3, matching.count
+    matching.each do |archive|
+      assert_match /Ruby/, archive.title
+    end
+  end
+
+  test "index with search returns no results when no match" do
+    get archives_url, params: { q: "非存在タイトル" }
+    assert_response :success
+    matching = assigns(:archives)
+    assert_equal 0, matching.count
+  end
+
+  test "index without search returns all archives" do
+    get archives_url
+    assert_response :success
+    expected_count = Archive.count
+    actual_count = assigns(:archives).count
+    assert_equal expected_count, actual_count
+  end
