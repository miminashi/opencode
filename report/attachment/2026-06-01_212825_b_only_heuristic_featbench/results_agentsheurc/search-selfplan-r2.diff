diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..32672cd 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,39 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope with matching title" do
+    results = Archive.search("Ruby")
+    assert_equal 3, results.count
+    assert_includes results.pluck(:title), "Ruby 入門講座"
+    assert_includes results.pluck(:title), "Ruby on Rails 完全ガイド"
+    assert_includes results.pluck(:title), "Ruby テスト手法"
+  end
+
+  test "search scope with partial title match" do
+    results = Archive.search("Rails")
+    assert_equal 2, results.count
+    assert_includes results.pluck(:title), "Rails で Web アプリ作成"
+    assert_includes results.pluck(:title), "Ruby on Rails 完全ガイド"
+  end
+
+  test "search scope with no matching title" do
+    results = Archive.search("非存在タイトル")
+    assert_equal 0, results.count
+  end
+
+  test "search scope with empty string returns all" do
+    results = Archive.search("")
+    assert_equal Archive.count, results.count
+  end
+
+  test "search scope can be chained with other scopes" do
+    ruby_archives = Archive.search("Ruby")
+    assert_equal 3, ruby_archives.count
+    results = ruby_archives.ordered
+    assert_equal 3, results.count
+    first_id = results.first.id
+    second_id = results.second.id
+    assert first_id > second_id, "Results should be ordered by id descending"
+  end
 end
