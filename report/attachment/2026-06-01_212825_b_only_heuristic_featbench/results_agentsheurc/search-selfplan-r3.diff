diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..faea58a 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,57 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns archives matching title (partial match)" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby入門チュートリアル")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Railsチュートリアル")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1234567", title: "Python入門")
+
+    results = Archive.search("チュートリアル")
+    assert_equal 2, results.count
+    assert_includes results.map(&:id), archive1.id
+    assert_includes results.map(&:id), archive2.id
+    assert_not results.map(&:id).include?(archive3.id)
+  end
+
+  test "search scope is case-insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby入門")
+
+    results_upper = Archive.search("RUBY")
+    assert_equal 1, results_upper.count
+
+    results_lower = Archive.search("ruby")
+    assert_equal 1, results_lower.count
+
+    results_mixed = Archive.search("RuBy")
+    assert_equal 1, results_mixed.count
+  end
+
+  test "search scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby入門")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Railsチュートリアル")
+
+    results = Archive.search("Python")
+    assert_equal 0, results.count
+  end
+
+  test "search scope returns all records when query is blank" do
+    count_before = Archive.count
+
+    results_empty = Archive.search("")
+    assert_equal count_before, results_empty.count
+
+    results_nil = Archive.search(nil)
+    assert_equal count_before, results_nil.count
+  end
+
+  test "search scope can chain with ordered scope" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby入門")
+    sleep 0.1
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rubyチュートリアル")
+
+    results = Archive.search("Ruby").ordered
+    assert_equal 2, results.count
+    assert_equal archive2.id, results.first.id
+  end
 end
