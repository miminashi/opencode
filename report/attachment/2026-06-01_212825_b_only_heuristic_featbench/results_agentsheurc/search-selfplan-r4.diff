     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should filter archives by title search - matching results" do
+    get archives_url, params: { q: "Done" }
+    assert_response :success
+    assert_select ".article", count: 1
+    assert_includes response.body, "Done Video"
+  end
+
+  test "should filter archives by title search - partial match" do
+    get archives_url, params: { q: "Video" }
+    assert_response :success
+    assert_select ".article", count: 4
+  end
+
+  test "should filter archives by title search - no results" do
+    get archives_url, params: { q: "非existent" }
+    assert_response :success
+    assert_select ".article", count: 0
+  end
+
+  test "should return all archives when search query is empty" do
+    get archives_url, params: { q: "" }
+    assert_response :success
+    assert_select ".article", count: 8
+  end
+
+  test "should return all archives when no search query" do
+    get archives_url
+    assert_response :success
+    assert_select ".article", count: 8
+  end
+
+  test "should filter archives by title search - case insensitive" do
+    get archives_url, params: { q: "done" }
