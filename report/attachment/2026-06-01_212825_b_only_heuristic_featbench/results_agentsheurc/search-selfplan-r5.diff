+    assert_select "article.article", count: 0
+  end
+
+  test "should get index without search query - returns all" do
+    Archive.create!(original_url: "https://vimeo.com/400", title: "Extra Video 1")
+    Archive.create!(original_url: "https://vimeo.com/401", title: "Extra Video 2")
