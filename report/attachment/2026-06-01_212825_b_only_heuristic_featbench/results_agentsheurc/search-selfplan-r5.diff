diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..1846110 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,57 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope with matching query returns partial matches" do
+    Archive.create!(original_url: "https://vimeo.com/100", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/101", title: "Rails API Guide")
+    Archive.create!(original_url: "https://vimeo.com/102", title: "Python Basics")
+
+    results = Archive.search("Rails")
+    assert_equal 2, results.count
+    assert_includes results.pluck(:title), "Ruby on Rails Tutorial"
+    assert_includes results.pluck(:title), "Rails API Guide"
+  end
+
+  test "search scope is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/200", title: "Test Video")
+
+    results_lower = Archive.search("test video")
+    results_upper = Archive.search("TEST VIDEO")
+    results_mixed = Archive.search("TeSt ViDeO")
+
+    assert_equal 1, results_lower.count
+    assert_equal 1, results_upper.count
+    assert_equal 1, results_mixed.count
+    assert_includes results_lower.pluck(:title), "Test Video"
+  end
+
+  test "search scope with empty string returns all archives" do
+    count_before = Archive.count
+    results = Archive.search("")
+    assert_equal count_before, results.count
+  end
+
+  test "search scope with nil returns all archives" do
+    count_before = Archive.count
+    results = Archive.search(nil)
+    assert_equal count_before, results.count
+  end
+
+  test "search scope with no matches returns empty collection" do
+    results = Archive.search("zzzznonexistentzzzz")
+    assert_equal 0, results.count
+    assert_empty results
+  end
+
+  test "search scope can be chained with ordered scope" do
+    Archive.create!(original_url: "https://vimeo.com/300", title: "Alpha Ruby")
+    Archive.create!(original_url: "https://vimeo.com/301", title: "Zeta Ruby")
+    Archive.create!(original_url: "https://vimeo.com/302", title: "Beta Ruby")
+
+    results = Archive.search("Ruby").ordered
+    titles = results.pluck(:title)
+    assert_equal 3, results.count
+    assert_equal ["Beta Ruby", "Zeta Ruby", "Alpha Ruby"], titles
+  end
 end
