@@ -62,6 +62,62 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should get index with search query - matching titles" do
+    Archive.create!(original_url: "https://vimeo.com/200", title: "Search Test Video A")
+    Archive.create!(original_url: "https://vimeo.com/201", title: "Search Test Video B")
+    Archive.create!(original_url: "https://vimeo.com/202", title: "Other Title")
+
+    get archives_url, params: { q: "Search Test" }
+    assert_response :success
+    assert_select "h2.article__title", minimum: 2
+    assert_select "h2.article__title", { text: "Search Test Video A", count: 1 }
+    assert_select "h2.article__title", { text: "Search Test Video B", count: 1 }
+    assert_select "h2.article__title", { text: "Other Title", count: 0 }
+  end
+
+  test "should get index with search query - case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/300", title: "Case Sensitive Video")
+
+    get archives_url, params: { q: "case sensitive" }
+    assert_response :success
+    assert_select "h2.article__title", { text: "Case Sensitive Video", count: 1 }
+  end
+
+  test "should get index with search query - no matches returns empty" do
+    get archives_url, params: { q: "zzzznonexistentzzzz" }
