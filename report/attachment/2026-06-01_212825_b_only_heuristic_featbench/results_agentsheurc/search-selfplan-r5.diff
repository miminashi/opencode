+    get archives_url
+    assert_response :success
+    assert_select "h2.article__title", minimum: 3
+  end
+
+  test "search form is present in index page" do
+    get archives_url
+    assert_response :success
+    assert_select "form[method=get][action='/archives']"
+    assert_select "input[name='q'][type='text']"
+    assert_select "input[type='submit'][value='検索']"
+  end
+
+  test "clear button is present when search query exists" do
+    get archives_url, params: { q: "test" }
+    assert_response :success
+    assert_select "a.btn--light[href='/archives']"
+  end
+
+  test "clear button is not present when no search query" do
+    get archives_url
+    assert_response :success
+    assert_select "a.btn--light[href='/archives']", count: 0
+  end
+
