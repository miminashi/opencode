@@ -62,6 +62,21 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should filter archives by title with q parameter" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+
+    get archives_url, params: { q: "Buck" }
+    assert_response :success
+    assert_includes response.body, "Big Buck Bunny"
+    assert_not_includes response.body, "Test Video"
+
+    get archives_url, params: { q: "nonexistent" }
+    assert_response :success
+    assert_not_includes response.body, "Big Buck Bunny"
+    assert_not_includes response.body, "Test Video"
+  end
