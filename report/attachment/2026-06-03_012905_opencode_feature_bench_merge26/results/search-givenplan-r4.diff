diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..277fa39 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,37 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives" do
+    unique_id = SecureRandom.hex(8)
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "UniqueTitleBuck#{unique_id}")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "UniqueTitleVideo#{unique_id}")
+    Archive.create!(original_url: "https://vimeo.com/1234567", title: "UniqueTitleFilm#{unique_id}")
+
+    result = Archive.search_by_title("Buck")
+    assert_equal 1, result.count
+    assert_equal "UniqueTitleBuck#{unique_id}", result.first.title
+
+    result = Archive.search_by_title("UniqueTitleVideo")
+    assert_equal 1, result.count
+    assert_includes result.first.title, "Video"
+  end
+
+  test "search_by_title returns empty when no match" do
+    unique_id = SecureRandom.hex(8)
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "UniqueTitleBuck#{unique_id}")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "UniqueTitleVideo#{unique_id}")
+
+    result = Archive.search_by_title("nonexistent")
+    assert_equal 0, result.count
+  end
+
+  test "search_by_title returns all when query is empty" do
+    unique_id = SecureRandom.hex(8)
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "UniqueTitleBuck#{unique_id}")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "UniqueTitleVideo#{unique_id}")
+
+    result = Archive.search_by_title("")
+    assert_equal Archive.count, result.count
+  end
 end
