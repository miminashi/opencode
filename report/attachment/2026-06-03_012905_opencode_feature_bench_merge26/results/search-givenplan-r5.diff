diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..1a24439 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,36 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title scope returns matching archives by partial title match" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+    Archive.create!(original_url: "https://vimeo.com/2222222", title: "Another Clip")
+
+    results = Archive.search_by_title("Buck")
+    assert_equal 1, results.count
+    assert_equal archive1.id, results.first.id
+  end
+
+  test "search_by_title scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+
+    results = Archive.search_by_title("xyznonexistent")
+    assert_equal 0, results.count
+  end
+
+  test "search_by_title scope returns all when query is blank" do
+    count_before = Archive.count
+    results = Archive.search_by_title("")
+    assert_equal count_before, results.count
+  end
+
+  test "search_by_title scope is case insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+
+    results = Archive.search_by_title("buck")
+    assert_equal 1, results.count
+    assert_equal archive.id, results.first.id
+  end
 end
