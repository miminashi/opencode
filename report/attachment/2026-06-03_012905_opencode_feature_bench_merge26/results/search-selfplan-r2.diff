   end
 
+  test "search by title - matching title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails 入門")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Python 講座")
+
+    get archives_url, params: { q: "Ruby" }
+    assert_response :success
+    assert_select ".article__title", text: "Ruby on Rails 入門", count: 1
+    assert_select ".article__title", text: "Python 講座", count: 0
+  end
