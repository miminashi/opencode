+    Archive.create!(original_url: "https://vimeo.com/1084540", title: "Rubyスクリプト")
+
+    get archives_url, params: { q: "Ruby" }
+    assert_response :success
+    assert_select ".article__title", text: /Ruby/, count: 2
+  end
+
+  test "search by title - empty query returns all" do
