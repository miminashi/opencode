diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..6a98e11 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,57 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope with matching query returns matching archives" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails タイトル")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python 動画")
+
+    results = Archive.search("ruby")
+    assert_equal 1, results.count
+    assert_includes results, archive1
+  end
+
+  test "search scope is case insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails")
+
+    results_upper = Archive.search("RUBY")
+    results_lower = Archive.search("ruby")
+    assert_equal 1, results_upper.count
+    assert_equal 1, results_lower.count
+    assert_includes results_upper, archive
+    assert_includes results_lower, archive
+  end
+
+  test "search scope with empty string returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "動画 A")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "動画 B")
+
+    results = Archive.search("")
+    assert_equal Archive.count, results.count
+  end
+
+  test "search scope with nil returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "動画 A")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "動画 B")
+
+    results = Archive.search(nil)
+    assert_equal Archive.count, results.count
+  end
+
+  test "search scope with no matches returns empty collection" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails")
+
+    results = Archive.search("zzz_nonexistent_zzz")
+    assert_equal 0, results.count
+  end
+
+  test "search scope chains with other scopes" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby 動画", status: Archive::Status::DONE)
+    sleep 0.1
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python 動画", status: Archive::Status::DONE)
+
+    results = Archive.search("ruby").ordered
+    assert_equal 1, results.count
+    assert_includes results, archive1
+  end
 end
diff --git a/test/system/archives_test.rb b/test/system/archives_test.rb
