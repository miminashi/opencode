     assert_text "test_10s.mov"
   end
+
+  test "タイトル検索機能" do
+    archive = Archive.create!(original_url: "https://vimeo.com/2084537", title: "Ruby 動画解説")
+    sleep 0.1
+    Archive.create!(original_url: "https://vimeo.com/2132937", title: "Python 入門")
+
+    visit archives_path
+    fill_in "search", with: "ruby"
+    find("#search").send_keys :enter
+
+    assert_text "Ruby 動画解説"
+    assert_no_text "Python 入門"
+  end
+
+  test "検索クリア機能" do
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Ruby 動画解説")
+    Archive.create!(original_url: "https://vimeo.com/2132937", title: "Python 入門")
+
+    visit archives_path
+    fill_in "search", with: "ruby"
+    find("#search").send_keys :enter
+
+    assert_text "Ruby 動画解説"
+    assert_no_text "Python 入門"
+
+    click_on "\u2715"
+
+    assert_text "Ruby 動画解説"
+    assert_text "Python 入門"
+  end
 end
