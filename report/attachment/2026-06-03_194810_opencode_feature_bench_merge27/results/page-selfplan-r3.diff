diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..e67ff04
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,41 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: 0.25rem;
+  margin-top: 2rem;
+  padding: 1rem 0;
+}
+
+.pagination a {
+  display: inline-block;
+  padding: 0.5rem 0.75rem;
+  border: 1px solid #dee2e6;
+  border-radius: 0.25rem;
+  text-decoration: none;
+  color: #0d6efd;
+  min-width: 2.5rem;
+  text-align: center;
+}
+
+.pagination a:hover {
+  background-color: #e9ecef;
+}
+
+.pagination .pagination__current {
+  display: inline-block;
+  padding: 0.5rem 0.75rem;
+  border: 1px solid #0d6efd;
+  border-radius: 0.25rem;
+  background-color: #0d6efd;
+  color: white;
+  min-width: 2.5rem;
+  text-align: center;
+}
+
+.pagination .pagination__gap {
+  display: inline-block;
+  padding: 0.5rem 0.75rem;
+  color: #6c757d;
+  pointer-events: none;
+}
