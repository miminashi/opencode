     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives on index" do
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{1000000 + i}", title: "Paginated Video #{i}")
+    end
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert_select "h2", text: /Paginated Video/
+  end
+
+  test "should render pagination nav on index with multiple pages" do
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{2000000 + i}", title: "Nav Video #{i}")
+    end
+    get archives_url
+    assert_response :success
+    assert_select "nav.pagination"
+    assert_match %r{href.*page=1}, response.body
+    assert_match %r{href.*page=2}, response.body
+  end
