@@ -14,4 +14,12 @@
   <%= turbo_frame_tag("archives") do %>
     <%= render @archives %>
   <% end %>
+
+  <% if @pagy.last > 1 %>
+    <nav class="pagination">
+      <%= link_to "« 最初", {page: 1}, class: "pagination__link", data: {turbo: true} %>
+      <%== @pagy.series_nav %>
