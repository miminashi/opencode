diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..8f87c46 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,24 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title scope returns matching archives" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+    matching = Archive.search_by_title("buck")
+    assert_equal [archive1], matching.to_a
+  end
+
+  test "search_by_title scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    matching = Archive.search_by_title("notfound")
+    assert_equal [], matching.to_a
+  end
+
+  test "search_by_title scope returns all when q is blank" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937")
+    matching = Archive.search_by_title("")
+    assert_equal Archive.count, matching.count
+  end
 end
