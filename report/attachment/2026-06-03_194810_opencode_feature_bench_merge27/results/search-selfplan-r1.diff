@@ -62,6 +62,38 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should get index with search parameter" do
+    Archive.create!(original_url: "https://vimeo.com/search1", title: "Search Test Video")
+    Archive.create!(original_url: "https://vimeo.com/search2", title: "Another Video")
+    get archives_url, params: { q: "Search" }
+    assert_response :success
+  end
+
+  test "should filter archives by title with search parameter" do
+    Archive.create!(original_url: "https://vimeo.com/filter1", title: "Filter Test Title")
+    Archive.create!(original_url: "https://vimeo.com/filter2", title: "Different Title")
+    get archives_url, params: { q: "Filter" }
+    assert_response :success
+    assert_select ".article__title", text: /Filter Test Title/
+  end
+
+  test "should return partial match results when searching by title" do
+    Archive.create!(original_url: "https://vimeo.com/partial1", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/partial2", title: "Elephants Dream")
+    get archives_url, params: { q: "bunny" }
+    assert_response :success
+    assert_select ".article__title", text: /Big Buck Bunny/
+  end
+
+  test "should return all results when search parameter is empty" do
+    Archive.create!(original_url: "https://vimeo.com/empty1", title: "Empty Search Test A")
+    Archive.create!(original_url: "https://vimeo.com/empty2", title: "Empty Search Test B")
+    get archives_url, params: { q: "" }
+    assert_response :success
+    assert_select ".article__title", text: /Empty Search Test A/
+    assert_select ".article__title", text: /Empty Search Test B/
+  end
