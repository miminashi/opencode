+  test "should search archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Python Programming")
+
+    get archives_url, params: { search: "Ruby" }
+    assert_response :success
+    assert_includes response.body, "Ruby on Rails Tutorial"
+    assert_not_includes response.body, "Python Programming"
+  end
+
+  test "should return all archives when search is blank" do
+    get archives_url, params: { search: "" }
+    assert_response :success
+  end
+
+  test "should return no results for non-matching search query" do
+    get archives_url, params: { search: "zzzzz_not_found" }
+    assert_response :success
+    assert_not_includes response.body, "Ruby on Rails Tutorial"
+  end
