diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..8611688 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,35 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives by title" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/2084537", title: "Search Ruby Tutorial")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/2094537", title: "Search Ruby Intro")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/2104537", title: "Docker Explainer")
+
+    results = Archive.search("Ruby")
+    assert_equal 2, results.count
+    assert_includes results.map(&:title), "Search Ruby Tutorial"
+    assert_includes results.map(&:title), "Search Ruby Intro"
+    assert_not_includes results.map(&:title), "Docker Explainer"
+  end
+
+  test "search scope returns all archives when query is empty" do
+    count_before = Archive.count
+    results = Archive.search("")
+    assert_equal count_before, results.count
+  end
+
+  test "search scope returns all archives when query is nil" do
+    count_before = Archive.count
+    results = Archive.search(nil)
+    assert_equal count_before, results.count
+  end
+
+  test "search scope returns no results for non-matching query" do
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Unique Title ZZZ")
+
+    results = Archive.search("存在しないタイトル")
+    assert_equal 0, results.count
+  end
 end
diff --git a/test/system/archives_test.rb b/test/system/archives_test.rb
index 9751efc..83bef7d 100644
--- a/test/system/archives_test.rb
+++ b/test/system/archives_test.rb
@@ -38,4 +38,32 @@ class ArchivesTest < ApplicationSystemTestCase
     assert_selector "h1", text: "保存したビデオ"
     assert_text "test_10s.mov"
   end
+
+  test "タイトル検索でアーカイブをフィルタリングできる" do
+    Archive.create!(title: "Web アプリ作成", original_url: "https://vimeo.com/3084537", status: "done")
+    Archive.create!(title: "Docker 入門", original_url: "https://vimeo.com/3094537", status: "done")
+
+    visit archives_path
+    fill_in "タイトルで検索", with: "Web"
+    click_on "検索"
+
+    assert_text "Web アプリ作成"
+    assert_no_text "Docker 入門"
+  end
+
+  test "検索結果が一致しない場合は該当動画が表示されない" do
+    visit archives_path
+    fill_in "タイトルで検索", with: "存在しないビデオ"
+    click_on "検索"
+
+    assert_no_text "Мimинаши"
+  end
+
+  test "空の検索キーワードで全件表示される" do
+    visit archives_path
+    fill_in "タイトルで検索", with: ""
+    click_on "検索"
+
+    assert_selector "h1", text: "保存したビデオ"
+  end
 end
