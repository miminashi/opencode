diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..6a36312 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -16,6 +16,10 @@ class ArchiveTest < ActiveSupport::TestCase
     @archive = Archive.new(original_url: "https://vimeo.com/1084537")
   end
 
+  def teardown
+    Archive.delete_all
+  end
+
   test "should be valid" do
     assert @archive.valid?
   end
@@ -142,4 +146,55 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby教程")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python教程")
+    Archive.create!(original_url: "https://vimeo.com/1132938", title: "Java入门")
+
+    results = Archive.search("教程")
+    assert_equal 2, results.count
+    assert_includes results.map(&:title), "Ruby教程"
+    assert_includes results.map(&:title), "Python教程"
+  end
+
+  test "search scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby教程")
+
+    results = Archive.search("Go言語")
+    assert_equal 0, results.count
+  end
+
+  test "search scope returns all archives when query is blank" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby教程")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python教程")
+
+    results_with_blank = Archive.search("")
+    assert_equal 6, results_with_blank.count
+
+    results_with_nil = Archive.search(nil)
+    assert_equal 6, results_with_nil.count
+  end
+
+  test "search scope is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby教程")
+
+    results_upper = Archive.search("RUBY")
+    assert_equal 1, results_upper.count
+    assert_includes results_upper.map(&:title), "Ruby教程"
+
+    results_lower = Archive.search("ruby")
+    assert_equal 1, results_lower.count
+    assert_includes results_lower.map(&:title), "Ruby教程"
+  end
+
+  test "search scope works with ordered scope" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "A動画")
+    sleep 0.1
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "B動画")
+
+    results = Archive.search("動画").ordered
+    assert_equal 2, results.count
+    assert_equal archive2.id, results.first.id
+  end
 end
