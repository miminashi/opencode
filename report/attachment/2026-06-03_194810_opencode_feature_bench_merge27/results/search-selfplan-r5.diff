diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..ed459e3 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,48 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "index with search param returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby教程")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python教程")
+
+    get archives_url, params: { search: "Ruby" }
+    assert_response :success
+    assert_select "h2.article__title", minimum: 1
+    assert_select "h2.article__title:contains('Ruby教程')", true
+  end
+
+  test "index with search param returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby教程")
+
+    get archives_url, params: { search: "Go言語" }
+    assert_response :success
+    assert_select "h2.article__title:contains('Go言語')", false
+  end
+
+  test "index with blank search param returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby教程")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python教程")
+
+    get archives_url, params: { search: "" }
+    assert_response :success
+  end
+
+  test "index without search param returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby教程")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python教程")
+
+    get archives_url
+    assert_response :success
+  end
+
+  test "index search is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby教程")
+
+    get archives_url, params: { search: "RUBY" }
+    assert_response :success
+    assert_select "h2.article__title:contains('Ruby教程')", true
+  end
+
