diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..5fc78df
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,61 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  padding: var(--space-m) 0;
+  gap: var(--space-xxs);
+}
+
+.pagination .pagy {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  align-items: center;
+  gap: var(--space-xxs);
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.pagination .pagy a,
+.pagination .pagy span {
+  display: inline-block;
+  padding: var(--space-xxs) var(--space-xs);
+  border: 1px solid #ddd;
+  border-radius: 4px;
+  text-decoration: none;
+  color: #333;
+  font-size: 0.875rem;
+  line-height: 1.5;
+  min-width: 2rem;
+  text-align: center;
+  box-sizing: border-box;
+}
+
+.pagination .pagy a:hover {
+  background-color: #f0f0f0;
+  border-color: #ccc;
+}
+
+.pagination .pagy .current {
+  background-color: #333;
+  border-color: #333;
+  color: #fff;
+  font-weight: bold;
+}
+
+.pagination .pagy .current:hover {
+  background-color: #333;
+  color: #fff;
+}
+
+.pagination .pagy .disabled {
+  color: #ccc;
+  pointer-events: none;
+}
+
+.pagination .pagy .separator {
+  border: none;
+  color: #999;
+  padding: var(--space-xxs) var(--space-xs);
+}
