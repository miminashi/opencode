diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..0b15745 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -15,6 +15,38 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "should paginate archives with 20 items per page" do
+    25.times do
+      Archive.create!(original_url: "https://vimeo.com/1084537", title: "Pagination Test Video")
+    end
+
+    get archives_url
+    assert_response :success
+
+    pagy = assigns(:pagy)
+    archives = assigns(:archives)
+
+    assert_equal 20, archives.size
+    assert_equal 2, pagy.pages
+    assert_equal 1, pagy.page
+  end
+
+  test "should show second page when page param is set" do
+    Archive.delete_all
+    25.times do
+      Archive.create!(original_url: "https://vimeo.com/1084537", title: "Pagination Test Video")
+    end
+
+    get archives_url, params: { page: "2" }
+    assert_response :success
+
+    archives = assigns(:archives)
+    pagy = assigns(:pagy)
+
+    assert_equal 5, archives.size
+    assert_equal 2, pagy.page
+  end
+
   test "should get new" do
     get new_archive_url
     assert_response :success
