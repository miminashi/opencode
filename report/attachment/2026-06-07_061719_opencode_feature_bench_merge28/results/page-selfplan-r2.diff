diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..1c2c95a
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,31 @@
+.will_paginate {
+  margin: 20px 0;
+  text-align: center;
+}
+
+.will_paginate ul.pagination {
+  list-style: none;
+  padding: 0;
+  display: inline-flex;
+  gap: 4px;
+}
+
+.will_paginate li a,
+.will_paginate li span {
+  display: inline-block;
+  padding: 8px 12px;
+  border: 1px solid #ddd;
+  border-radius: 4px;
+  text-decoration: none;
+  color: #0066cc;
+}
+
+.will_paginate li a:hover {
+  background-color: #f5f5f5;
+}
+
+.will_paginate li.current span {
+  background-color: #0066cc;
+  color: #fff;
+  border-color: #0066cc;
+}
