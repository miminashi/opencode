   end
+
+  test "ページネーションが表示される" do
+    # Create enough archives to trigger pagination (more than 20)
+    25.times do |i|
+      Archive.create!(original_url: "https://example.com/pagination_test_#{i}")
+    end
+
+    visit archives_path
+
+    assert_selector ".pagination"
+    assert_text /1 \/ \d+ ページ/
