diff --git a/app/controllers/archives_controller.rb b/app/controllers/archives_controller.rb
index f29361b..599337b 100644
--- a/app/controllers/archives_controller.rb
+++ b/app/controllers/archives_controller.rb
@@ -4,7 +4,21 @@ class ArchivesController < ApplicationController
 
   # GET /archives or /archives.json
   def index
-    @archives = Archive.ordered.with_attached_thumbnail.with_attached_video
+    per_page = 20
+    page = (params[:page] || 1).to_i
+    total_count = Archive.ordered.with_attached_thumbnail.with_attached_video.count
+    total_pages = (total_count.to_f / per_page).ceil
+    offset = (page - 1) * per_page
+
+    @archives = Archive.ordered.with_attached_thumbnail.with_attached_video.offset(offset).limit(per_page)
+    @pagination = {
+      current_page: page,
+      total_pages: total_pages,
+      total_entries: total_count,
+      per_page: per_page,
+      prev_page: page > 1 ? page - 1 : nil,
+      next_page: page < total_pages ? page + 1 : nil
+    }
   end
 
   # GET /archives/1 or /archives/1.json
diff --git a/app/views/archives/index.html.erb b/app/views/archives/index.html.erb
index 993e337..90331c3 100644
--- a/app/views/archives/index.html.erb
+++ b/app/views/archives/index.html.erb
@@ -14,4 +14,18 @@
   <%= turbo_frame_tag("archives") do %>
     <%= render @archives %>
   <% end %>
+
+  <% if @pagination && @pagination[:total_pages] > 1 %>
+    <div class="pagination">
+      <% if @pagination[:prev_page] %>
+        <%= link_to("前へ", archives_path(page: @pagination[:prev_page]), data: {turbo_frame: "archives"}, class: "btn btn--secondary") %>
+      <% end %>
+      <span class="pagination-info">
+        <%= @pagination[:current_page] %> / <%= @pagination[:total_pages] %> ページ
+      </span>
+      <% if @pagination[:next_page] %>
+        <%= link_to("次へ", archives_path(page: @pagination[:next_page]), data: {turbo_frame: "archives"}, class: "btn btn--secondary") %>
+      <% end %>
+    </div>
+  <% end %>
 </main>
diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..3d9f1e5 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,42 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate index results" do
+    # Create archives to ensure pagination kicks in (more than 20)
+    initial_count = Archive.count
+    25.times do |i|
+      Archive.create!(original_url: "https://example.com/video_#{i}")
+    end
+    expected_total = initial_count + 25
+    get archives_url
+    assert_response :success
+    assert_not_nil assigns(:archives)
+    assert_not_nil assigns(:pagination)
+    assert_equal expected_total, assigns(:pagination)[:total_entries]
+    assert_equal 2, assigns(:pagination)[:total_pages]
+  end
+
+  test "should show page 2 when page param is set" do
+    # Create 25 archives so page 2 has items
+    25.times do |i|
+      Archive.create!(original_url: "https://example.com/paged_video_#{i}")
+    end
+    get archives_url, params: { page: 2 }
+    assert_response :success
+    assert_not_nil assigns(:archives)
+    assert_equal 2, assigns(:pagination)[:current_page]
+    assert_equal 20, assigns(:pagination)[:per_page]
+  end
+
+  test "should show first page by default" do
+    25.times do |i|
+      Archive.create!(original_url: "https://example.com/default_page_video_#{i}")
+    end
+    get archives_url
+    assert_response :success
+    assert_equal 1, assigns(:pagination)[:current_page]
+  end
+
   #test "should get edit" do
   #  get edit_archive_url(@archive)
   #  assert_response :success
