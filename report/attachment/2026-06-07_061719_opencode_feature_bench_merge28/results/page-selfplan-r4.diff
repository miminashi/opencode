diff --git a/app/assets/stylesheets/pagy.css b/app/assets/stylesheets/pagy.css
new file mode 100644
index 0000000..69cc147
--- /dev/null
+++ b/app/assets/stylesheets/pagy.css
@@ -0,0 +1,39 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: 0.25rem;
+  margin-top: 2rem;
+  padding: 1rem 0;
+}
+
+.pagination a,
+.pagination span {
+  display: inline-block;
+  padding: 0.375rem 0.75rem;
+  border-radius: 0.25rem;
+  font-size: 0.875rem;
+  text-decoration: none;
+}
+
+.pagination a {
+  color: #0366d6;
+  background-color: #f6f8fa;
+  border: 1px solid #d1d5da;
+}
+
+.pagination a:hover {
+  background-color: #e5e7eb;
+}
+
+.pagination .current {
+  color: #ffffff;
+  background-color: #0366d6;
+  border: 1px solid #0366d6;
+  font-weight: bold;
+}
+
+.pagination .gap {
+  color: #6b7280;
+  pointer-events: none;
+}
