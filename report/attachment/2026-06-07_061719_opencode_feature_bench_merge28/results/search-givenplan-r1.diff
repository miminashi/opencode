diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..a10b947 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,25 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title scope finds partial matches" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+    results = Archive.search_by_title("buck")
+    assert_equal 1, results.count
+    assert_equal archive1.id, results.first.id
+  end
+
+  test "search_by_title scope returns empty for no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    results = Archive.search_by_title("nonexistent")
+    assert_equal 0, results.count
+  end
+
+  test "search_by_title scope returns all when q is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+    results = Archive.search_by_title("")
+    assert_equal Archive.count, results.count
+  end
 end
