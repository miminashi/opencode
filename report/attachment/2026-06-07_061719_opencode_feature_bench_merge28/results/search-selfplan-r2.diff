diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..4a9c217 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,45 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives when query provided" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python Programming")
+    matching = Archive.search("Ruby")
+    assert_equal 1, matching.count
+    assert_equal "Ruby on Rails Tutorial", matching.first.title
+  end
+
+  test "search scope returns all archives when query is blank" do
+    count = Archive.count
+    result = Archive.search("")
+    assert_equal count, result.count
+  end
+
+  test "search scope is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    matching_upper = Archive.search("RUBY")
+    matching_lower = Archive.search("ruby")
+    matching_mixed = Archive.search("RuBy")
+    assert_equal 1, matching_upper.count
+    assert_equal 1, matching_lower.count
+    assert_equal 1, matching_mixed.count
+  end
+
+  test "search scope returns empty result when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    matching = Archive.search("NotExistingTitle")
+    assert_equal 0, matching.count
+  end
+
+  test "search scope works with ordered scope" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Alpha Video")
+    sleep 0.1
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Beta Video")
+    sleep 0.1
+    Archive.create!(original_url: "https://vimeo.com/1182937", title: "Alpha Again")
+    matching = Archive.search("Alpha").ordered
+    assert_equal 2, matching.count
+    assert_equal "Alpha Again", matching.first.title
+  end
 end
