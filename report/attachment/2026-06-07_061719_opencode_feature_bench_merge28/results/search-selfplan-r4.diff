diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..9a742c7 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,37 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title scope returns matching archives" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video Title")
+    results = Archive.search_by_title("Test")
+    assert_includes results, archive
+  end
+
+  test "search_by_title scope does partial match" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    results = Archive.search_by_title("Rails")
+    assert_includes results, archive
+  end
+
+  test "search_by_title scope is case-insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video")
+    results = Archive.search_by_title("test")
+    assert_includes results, archive
+    results2 = Archive.search_by_title("VIDEO")
+    assert_includes results2, archive
+  end
+
+  test "search_by_title scope returns empty for no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Unique Title")
+    results = Archive.search_by_title("zzzznonexistent")
+    assert_equal 0, results.count
+  end
+
+  test "search_by_title scope with empty string returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video A")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video B")
+    results = Archive.search_by_title("")
+    assert_equal Archive.count, results.count
+  end
 end
