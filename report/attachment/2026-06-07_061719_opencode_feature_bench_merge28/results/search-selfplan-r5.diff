diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..ad0d908 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,42 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "index with search query returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+
+    get archives_url, params: { q: "Big" }
+    assert_response :success
+    assert_includes response.body, "Big Buck Bunny"
+    assert_not_includes response.body, "Test Video"
+  end
+
+  test "index with search query returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+
+    get archives_url, params: { q: "ZZZZZ_not_found" }
+    assert_response :success
+    assert_not_includes response.body, "Big Buck Bunny"
+  end
+
+  test "index without search query returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video One")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video Two")
+
+    get archives_url
+    assert_response :success
+    assert_includes response.body, "Video One"
+    assert_includes response.body, "Video Two"
+  end
+
+  test "index search is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+
+    get archives_url, params: { q: "BIG" }
+    assert_response :success
+    assert_includes response.body, "Big Buck Bunny"
+  end
+
