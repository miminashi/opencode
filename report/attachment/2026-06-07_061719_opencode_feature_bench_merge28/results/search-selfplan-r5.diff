diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..646573d 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -111,6 +111,42 @@ class ArchiveTest < ActiveSupport::TestCase
     assert_equal archives(:failed_archive).id, failed_archives.first.id
   end
 
+  test "search scope returns matching archives by title" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1182937", title: "Another Movie")
+
+    result = Archive.search("Big")
+    assert_equal 1, result.count
+    assert_equal archive1.id, result.first.id
+  end
+
+  test "search scope is case insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+
+    result_upper = Archive.search("BIG")
+    result_lower = Archive.search("buck")
+    assert_equal 1, result_upper.count
+    assert_equal archive.id, result_upper.first.id
+    assert_equal 1, result_lower.count
+    assert_equal archive.id, result_lower.first.id
+  end
+
+  test "search scope returns all archives when query is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video One")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video Two")
+
+    result = Archive.search("")
+    assert_equal Archive.count, result.count
+  end
+
+  test "search scope returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+
+    result = Archive.search("ZZZZZ_not_found")
+    assert_equal 0, result.count
+  end
+
