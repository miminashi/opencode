diff --git a/test/system/archives_test.rb b/test/system/archives_test.rb
index 9751efc..cece6d9 100644
--- a/test/system/archives_test.rb
+++ b/test/system/archives_test.rb
@@ -38,4 +38,37 @@ class ArchivesTest < ApplicationSystemTestCase
     assert_selector "h1", text: "保存したビデオ"
     assert_text "test_10s.mov"
   end
+
+  test "ページネーション - 1ページ以内の件数ではページネーションリンクが表示されない" do
+    15.times do |i|
+      Archive.create!(original_url: "https://example.com/paginate/#{i}", status: Archive::Status::DONE, title: "Pagination Test #{i}")
+    end
+
+    visit archives_path
+
+    assert_no_selector ".pagination"
+  end
+
+  test "ページネーション - ちょうど20件の場合、2ページ目のリンクは表示されない" do
+    20.times do |i|
+      Archive.create!(original_url: "https://example.com/paginate/#{i}", status: Archive::Status::DONE, title: "Pagination Boundary #{i}")
+    end
+
+    visit archives_path
+
+    assert_no_selector ".pagination"
+  end
+
+  test "ページネーション - 20件超えの場合、2ページ目に遷移できる" do
+    21.times do |i|
+      Archive.create!(original_url: "https://example.com/paginate/#{i}", status: Archive::Status::DONE, title: "Pagination Overflow #{i}")
+    end
+
+    visit archives_path
+
+    assert_selector ".pagination"
+    click_on "2"
+
+    assert_selector ".pagination"
+  end
 end
