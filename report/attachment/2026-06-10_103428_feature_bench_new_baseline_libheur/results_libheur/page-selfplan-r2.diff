diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..5f6cdfd 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,37 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives with more than 20 items" do
+    # Create 21 archives to test pagination boundary
+    21.times do |i|
+      Archive.create!(original_url: "https://example.com/video/#{i}", status: Archive::Status::DONE, title: "Paginated Video #{i}")
+    end
+
+    get archives_url
+    assert_response :success
+    assert_equal 20, assigns(:archives).size
+  end
+
+  test "should support page parameter for pagination" do
+    # Clear existing archives to have exact control over count
+    Archive.delete_all
+
+    # Create 21 archives to ensure there is a second page
+    21.times do |i|
+      Archive.create!(original_url: "https://example.com/video/#{i}", status: Archive::Status::DONE, title: "Page Test Video #{i}")
+    end
+
+    # First page
+    get archives_url, params: { page: "1" }
+    assert_response :success
+    assert_equal 20, assigns(:archives).size
+
+    # Second page
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert_equal 1, assigns(:archives).size
+  end
+
   #test "should get edit" do
