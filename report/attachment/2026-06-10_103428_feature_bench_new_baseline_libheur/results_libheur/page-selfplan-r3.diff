diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..4ee7fa3 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -15,6 +15,36 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "should paginate archives with more than 20 items" do
+    baseline_count = Archive.count
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/108453#{i}")
+    end
+    get archives_url
+    assert_response :success
+    assert_equal 20, assigns(:archives).limit_value
+    assert_equal 1, assigns(:archives).current_page
+    assert assigns(:archives).length <= 20
+  end
+
+  test "should paginate archives with page parameter" do
+    baseline_count = Archive.count
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/108453#{i}")
+    end
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert_equal 2, assigns(:archives).current_page
+    assert assigns(:archives).length > 0
+    assert assigns(:archives).length <= 20
+  end
+
+  test "should paginate archives with out of range page parameter" do
+    get archives_url, params: { page: "999" }
+    assert_response :success
+    assert_equal 0, assigns(:archives).length
+  end
+
   test "should get new" do
     get new_archive_url
     assert_response :success
diff --git a/test/system/archives_test.rb b/test/system/archives_test.rb
index 9751efc..cd8db96 100644
--- a/test/system/archives_test.rb
+++ b/test/system/archives_test.rb
@@ -38,4 +38,37 @@ class ArchivesTest < ApplicationSystemTestCase
     assert_selector "h1", text: "保存したビデオ"
     assert_text "test_10s.mov"
   end
+
+  test "ページネーションが表示される" do
+    # 25件のアーカイブを作成（1ページの上限20件を超える）
+    perform_enqueued_jobs do
+      25.times do |i|
+        Archive.create!(original_url: "https://vimeo.com/108453#{i}")
+      end
+    end
+
+    visit archives_path
+
+    # ページネーションUIが表示される
+    assert_selector ".pagination"
+  end
+
+  test "2ページ目に遷移できる" do
+    perform_enqueued_jobs do
+      25.times do |i|
+        Archive.create!(original_url: "https://vimeo.com/108453#{i}")
+      end
+    end
+
+    visit archives_path
+
+    # 2ページ目のリンクが存在する
+    assert_selector ".pagination a", text: "2"
+
+    # 2ページ目に遷移
+    click_on "2"
+
+    # 2ページ目が表示される（10件目以降のアーカイブが表示される）
+    assert_selector ".pagination"
+  end
 end
