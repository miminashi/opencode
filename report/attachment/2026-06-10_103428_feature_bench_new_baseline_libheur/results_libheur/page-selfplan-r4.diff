diff --git a/test/integration/archive_pagination_test.rb b/test/integration/archive_pagination_test.rb
new file mode 100644
index 0000000..d07c290
--- /dev/null
+++ b/test/integration/archive_pagination_test.rb
@@ -0,0 +1,67 @@
+require "test_helper"
+
+class ArchivePaginationTest < ActionDispatch::IntegrationTest
+  test "index page shows 20 archives on first page" do
+    (1..25).each do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{1084537 + i}", title: "Pagination Video #{i}")
+    end
+
+    get archives_url
+    assert_response :success
+    assert_select ".article", count: 20
+  end
+
+  test "index page shows remaining archives on second page" do
+    (1..25).each do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{1084537 + i}", title: "Pagination Video #{i}")
+    end
+
+    # fixtures have 4 records + 25 test records = 29 total
+    # page 1: 20, page 2: 9
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert_select ".article", count: 9
+  end
+
+  test "pagination links are displayed when there are more than 20 archives" do
+    (1..25).each do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{1084537 + i}", title: "Pagination Video #{i}")
+    end
+
+    get archives_url
+    assert_response :success
+    assert_select ".pagination"
+  end
+
+  test "pagination is not displayed when all archives fit on one page" do
+    get archives_url
+    assert_response :success
+    count = response.body.scan(/class="article"/).length
+    assert count <= 20
+    assert_select ".pagination", false
+  end
+
+  test "page parameter correctly switches pages" do
+    (1..45).each do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{2084537 + i}", title: "Page Switch Video #{i}")
+    end
+
+    # fixtures have 4 records + 45 test records = 49 total
+    # page 1: 20, page 2: 20, page 3: 9
+    get archives_url, params: { page: "3" }
+    assert_response :success
+    assert_select ".article", count: 9
+  end
+
+  test "first page shows the most recent archives" do
+    (1..25).each do |i|
+      Archive.create!(original_url: "https://vimeo.com/#{1084537 + i}", title: "Pagination Video #{i}")
+    end
+
+    latest = Archive.create!(original_url: "https://vimeo.com/9999999", title: "Latest Video")
+
+    get archives_url
+    assert_response :success
+    assert_select "h2", "Latest Video"
+  end
+end
