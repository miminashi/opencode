diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..e085465
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,46 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: 0.5rem;
+  margin-top: 2rem;
+  padding: 1rem 0;
+}
+
+.pagination .page,
+.pagination .gap,
+.pagination .current {
+  display: inline-block;
+}
+
+.pagination a.page,
+.pagination span.page,
+.pagination span.current {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 2rem;
+  height: 2rem;
+  padding: 0 0.5rem;
+  text-decoration: none;
+  border: 1px solid #ddd;
+  border-radius: 4px;
+  color: #333;
+  font-size: 0.9rem;
+}
+
+.pagination a.page:hover {
+  background-color: #f5f5f5;
+  border-color: #ccc;
+}
+
+.pagination span.current {
+  background-color: #007bff;
+  border-color: #007bff;
+  color: #fff;
+}
+
+.pagination .gap {
+  padding: 0 0.5rem;
+  color: #999;
+}
