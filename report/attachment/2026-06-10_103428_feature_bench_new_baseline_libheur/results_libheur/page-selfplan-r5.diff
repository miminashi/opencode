diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..d3efd8a
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,52 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  margin: 20px 0;
+  gap: 4px;
+}
+
+.pagination ul.page {
+  display: flex;
+  list-style: none;
+  padding: 0;
+  margin: 0;
+  gap: 4px;
+}
+
+.pagination li a,
+.pagination li span {
+  display: inline-block;
+  padding: 8px 12px;
+  border: 1px solid #ddd;
+  border-radius: 4px;
+  text-decoration: none;
+  color: #0066cc;
+  background-color: #fff;
+  transition: background-color 0.2s, color 0.2s;
+}
+
+.pagination li a:hover {
+  background-color: #f0f0f0;
+  color: #004499;
+}
+
+.pagination li.current span {
+  font-weight: bold;
+  background-color: #0066cc;
+  color: #fff;
+  border-color: #0066cc;
+}
+
+.pagination li.disabled a,
+.pagination li.disabled span {
+  color: #999;
+  background-color: #f9f9f9;
+  border-color: #ddd;
+  cursor: default;
+}
+
+.pagination li.disabled a:hover {
+  background-color: #f9f9f9;
+  color: #999;
+}
