diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..cc516fc 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,46 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives on index" do
+    25.times do |i|
+      Archive.create!(title: "Pagination Test #{i}", original_url: "https://vimeo.com/pag#{i}", status: "done")
+    end
+
+    get archives_url
+    assert_response :success
+    assert_equal 20, @controller.instance_variable_get(:@archives).size
+    assert_equal 30, @controller.instance_variable_get(:@archives).total_count
+    assert_equal 2, @controller.instance_variable_get(:@archives).total_pages
+  end
+
+  test "should show second page with page parameter" do
+    25.times do |i|
+      Archive.create!(title: "Pagination Test #{i}", original_url: "https://vimeo.com/pag2#{i}", status: "done")
+    end
+
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    second_page = @controller.instance_variable_get(:@archives)
+    assert_equal 10, second_page.size
+    assert_equal 2, second_page.current_page
+  end
+
+  test "should not show pagination UI when only one page" do
+    get archives_url
+    assert_response :success
+    assert_select ".pagination", count: 0
+  end
+
+  test "should show pagination UI when multiple pages" do
+    25.times do |i|
+      Archive.create!(title: "Pagination Test #{i}", original_url: "https://vimeo.com/pag3#{i}", status: "done")
+    end
+
+    get archives_url
+    assert_response :success
+    assert_select "div.pagination", count: 1
+  end
+
