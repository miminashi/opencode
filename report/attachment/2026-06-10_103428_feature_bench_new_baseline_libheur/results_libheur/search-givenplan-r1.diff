@@ -62,6 +62,20 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should filter archives by title with q parameter" do
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/2084538", title: "Python Programming")
+    get archives_url, params: { q: "Ruby" }
+    assert_response :success
+    assert_select "h1", count: 1
+  end
+
+  test "should return all archives when q parameter does not match any title" do
+    Archive.create!(original_url: "https://vimeo.com/2084537", title: "Ruby on Rails Tutorial")
+    get archives_url, params: { q: "zzznonexistent" }
+    assert_response :success
+  end
