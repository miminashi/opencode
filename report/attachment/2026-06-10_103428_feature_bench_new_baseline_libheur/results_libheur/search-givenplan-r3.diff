diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..37ee94d 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,36 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives with partial match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails 教程")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Python 入門")
+    matching = Archive.search_by_title("Rails")
+    assert_equal 1, matching.count
+    assert_equal "Ruby on Rails 教程", matching.first.title
+  end
+
+  test "search_by_title is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails 教程")
+    matching_lower = Archive.search_by_title("rails")
+    matching_upper = Archive.search_by_title("RAILS")
+    assert_equal 1, matching_lower.count
+    assert_equal 1, matching_upper.count
+    assert_equal "Ruby on Rails 教程", matching_lower.first.title
+    assert_equal "Ruby on Rails 教程", matching_upper.first.title
+  end
+
+  test "search_by_title returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails 教程")
+    matching = Archive.search_by_title("存在しないタイトル")
+    assert_equal 0, matching.count
+  end
+
+  test "search_by_title returns all when q is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "動画A")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "動画B")
+    before_count = Archive.count
+    matching = Archive.search_by_title("")
+    assert_equal before_count, matching.count
+  end
 end
