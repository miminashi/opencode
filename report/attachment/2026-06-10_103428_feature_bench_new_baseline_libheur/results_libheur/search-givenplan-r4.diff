--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,27 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "index with q parameter filters archives by title" do
+    Archive.create!(original_url: "https://example.com/1", title: "Search Test Video")
+    Archive.create!(original_url: "https://example.com/2", title: "Another Video Title")
+
+    get archives_url, params: { q: "Search Test" }
+    assert_response :success
+    assert_includes response.body, "Search Test Video"
+    assert_not_includes response.body, "Another Video Title"
+  end
+
+  test "index with q parameter returns empty results when no match" do
+    get archives_url, params: { q: "zzzzz_no_match" }
+    assert_response :success
+    assert_not_includes response.body, "Search Test Video"
+  end
+
+  test "index with empty q parameter shows all archives" do
+    get archives_url, params: { q: "" }
+    assert_response :success
+  end
