diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..f444f0c 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,40 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives with partial match" do
+    Archive.create!(original_url: "https://example.com/1", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://example.com/2", title: "Python Programming")
+    Archive.create!(original_url: "https://example.com/3", title: "Rails API Development")
+
+    results = Archive.search_by_title("Rails")
+    assert_equal 2, results.count
+    assert_includes results.map(&:title), "Ruby on Rails Tutorial"
+    assert_includes results.map(&:title), "Rails API Development"
+  end
+
+  test "search_by_title is case insensitive" do
+    archive = Archive.create!(original_url: "https://example.com/1", title: "Test Video Title")
+
+    assert_equal 1, Archive.search_by_title("test").count
+    assert_equal 1, Archive.search_by_title("TEST").count
+    assert_equal 1, Archive.search_by_title("Test").count
+  end
+
+  test "search_by_title with empty string returns all archives" do
+    count = Archive.count
+    results = Archive.search_by_title("")
+    assert_equal count, results.count
+  end
+
+  test "search_by_title with nil returns all archives" do
+    count = Archive.count
+    results = Archive.search_by_title(nil)
+    assert_equal count, results.count
+  end
+
+  test "search_by_title returns empty when no match" do
+    results = Archive.search_by_title("zzzzz_no_match")
+    assert_equal 0, results.count
+  end
 end
