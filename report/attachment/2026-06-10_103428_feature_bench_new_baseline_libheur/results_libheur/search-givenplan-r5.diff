diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..bcfdfab 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,36 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should filter archives by title with q parameter" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Test Video")
+    Archive.create!(original_url: "https://vimeo.com/1084539", title: "Another Film")
+
+    get archives_url, params: { q: "Buck" }
+    assert_response :success
+    assert_includes response.body, "Big Buck Bunny"
+    assert_not_includes response.body, "Test Video"
+    assert_not_includes response.body, "Another Film"
+  end
+
+  test "should show all archives when q parameter is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Test Video")
+
+    get archives_url, params: { q: "" }
+    assert_response :success
+    assert_includes response.body, "Big Buck Bunny"
+    assert_includes response.body, "Test Video"
+  end
+
+  test "should return no matching archives when q parameter has no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+
+    get archives_url, params: { q: "nonexistent" }
+    assert_response :success
+    assert_not_includes response.body, "Big Buck Bunny"
+  end
+
