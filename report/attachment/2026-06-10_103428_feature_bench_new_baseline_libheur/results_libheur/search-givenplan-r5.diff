diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..908b742 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,53 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives with partial match" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "XYZ Alpha Test")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1084538", title: "XYZ Beta Demo")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1084539", title: "XYZ Gamma Preview")
+
+    results = Archive.search_by_title("Alpha")
+    assert_equal 1, results.count
+    assert_equal archive1.id, results.first.id
+
+    results = Archive.search_by_title("beta")
+    assert_equal 1, results.count
+    assert_equal archive2.id, results.first.id
+
+    results = Archive.search_by_title("preview")
+    assert_equal 1, results.count
+    assert_equal archive3.id, results.first.id
+  end
+
+  test "search_by_title returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "XYZ Alpha Test")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "XYZ Beta Demo")
+
+    results = Archive.search_by_title("zzznonexistentzzz")
+    assert_equal 0, results.count
+  end
+
+  test "search_by_title returns all when q is blank" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "XYZ Alpha Test")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1084538", title: "XYZ Beta Demo")
+
+    results = Archive.search_by_title(nil)
+    assert_equal 6, results.count
+
+    results = Archive.search_by_title("")
+    assert_equal 6, results.count
+  end
+
+  test "search_by_title is case insensitive" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "XYZ Alpha Test")
+
+    results_lower = Archive.search_by_title("alpha")
+    assert_equal 1, results_lower.count
+    assert_equal archive1.id, results_lower.first.id
+
+    results_upper = Archive.search_by_title("ALPHA")
+    assert_equal 1, results_upper.count
+    assert_equal archive1.id, results_upper.first.id
+  end
 end
