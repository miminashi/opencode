diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..fbe742a 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,34 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should search archives by title" do
+    get archives_url, params: { q: "Ruby" }
+    assert_response :success
+    assert_select ".article__title", text: /Ruby Tutorial for Beginners/
+  end
+
+  test "should return partial match results" do
+    get archives_url, params: { q: "Video" }
+    assert_response :success
+    assert_select ".article__title", text: /Done Video/
+    assert_select ".article__title", text: /Music Video Collection/
+  end
+
+  test "should return all archives when query is empty" do
+    get archives_url, params: { q: "" }
+    assert_response :success
+    assert_includes response.body, "Waiting Video"
+    assert_includes response.body, "Done Video"
+    assert_includes response.body, "Failed Video"
+    assert_includes response.body, "Ruby Tutorial for Beginners"
+  end
+
+  test "should return no results when no match" do
+    get archives_url, params: { q: "zzzzz_nonexistent" }
+    assert_response :success
+    refute_includes response.body, "article__title"
+  end
+
