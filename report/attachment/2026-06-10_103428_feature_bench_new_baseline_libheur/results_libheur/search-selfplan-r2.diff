diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..9db678e 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,57 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search returns matching archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "React 入門ガイド")
+    Archive.create!(original_url: "https://vimeo.com/1084539", title: "Ruby パフォーマンス最適化")
+
+    results = Archive.search("Ruby")
+    assert_equal 2, results.count
+    assert_includes results.pluck(:title), "Ruby on Rails チュートリアル"
+    assert_includes results.pluck(:title), "Ruby パフォーマンス最適化"
+  end
+
+  test "search returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    results = Archive.search("Python")
+    assert_equal 0, results.count
+  end
+
+  test "search with empty string returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "React 入門ガイド")
+    all_count = Archive.count
+
+    results = Archive.search("")
+    assert_equal all_count, results.count
+  end
+
+  test "search with nil returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "React 入門ガイド")
+    all_count = Archive.count
+
+    results = Archive.search(nil)
+    assert_equal all_count, results.count
+  end
+
+  test "search is case sensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "ruby 入門")
+
+    upper = Archive.search("Ruby")
+    lower = Archive.search("ruby")
+    assert_equal 1, upper.count
+    assert_equal 1, lower.count
+    assert_equal "ruby 入門", lower.first.title
+  end
+
+  test "search with partial match in middle of title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails チュートリアル")
+    results = Archive.search("Rails")
+    assert_equal 1, results.count
+    assert_equal "Ruby on Rails チュートリアル", results.first.title
+  end
 end
diff --git a/test/system/archives_test.rb b/test/system/archives_test.rb
index 9751efc..fdadd42 100644
--- a/test/system/archives_test.rb
+++ b/test/system/archives_test.rb
@@ -38,4 +38,31 @@ class ArchivesTest < ApplicationSystemTestCase
     assert_selector "h1", text: "保存したビデオ"
     assert_text "test_10s.mov"
   end
+
+  test "検索機能でタイトルからフィルタリングできる" do
+    Archive.create!(original_url: "https://vimeo.com/3084537", title: "Ruby チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/3084538", title: "Python 入門")
+
+    visit archives_path
+    fill_in "q", with: "Ruby"
+    click_on "検索"
+
+    assert_text "Ruby チュートリアル"
