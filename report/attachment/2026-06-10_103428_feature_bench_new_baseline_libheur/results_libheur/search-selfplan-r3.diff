diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..6c9ed45 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,47 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should search archives by title (partial match)" do
+    get archives_url, params: { q: "Done Video" }
+    assert_response :success
+    assert_select ".article__title", count: 2
+  end
+
+  test "should return empty when no title matches" do
+    get archives_url, params: { q: "NonExistentTitle12345" }
+    assert_response :success
+    assert_select ".article__title", count: 0
+  end
+
+  test "should return all archives when no search parameter" do
+    get archives_url
+    assert_response :success
+    assert_equal Archive.count, response.body.scan(/class="article__title"/).count
+  end
+
+  test "should return search results in correct order (id descending)" do
+    get archives_url, params: { q: "Tutorial" }
+    assert_response :success
+    titles = response.body.scan(/<h2 class="article__title">([^<]+)<\/h2>/)
+    assert_equal 1, titles.size
+    assert_equal "Done Video - Tutorial Part 1", titles[0][0]
+  end
+
+  test "should return search results in correct order (id descending) with multiple matches" do
+    get archives_url, params: { q: "Done Video" }
+    assert_response :success
+    titles = response.body.scan(/<h2 class="article__title">([^<]+)<\/h2>/)
+    assert titles.size >= 2, "Expected at least 2 results"
+    assert_equal "Done Video - Tutorial Part 1", titles[0][0]
+    assert_equal "Done Video", titles[1][0]
+  end
+
+  test "should be case-insensitive search (ILIKE)" do
+    get archives_url, params: { q: "done video" }
+    assert_response :success
+    assert_select ".article__title", count: 2
+  end
+
