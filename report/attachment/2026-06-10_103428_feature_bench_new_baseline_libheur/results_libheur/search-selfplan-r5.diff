diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..f7b90b3 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,40 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search returns matching archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails 8 Introduction")
+    Archive.create!(original_url: "https://vimeo.com/1182937", title: "Python Programming")
+
+    results = Archive.search("Rails")
+    assert_equal 2, results.count
+    assert_includes results.map(&:title), "Ruby on Rails Tutorial"
+    assert_includes results.map(&:title), "Rails 8 Introduction"
+  end
+
+  test "search is case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+
+    results_lower = Archive.search("rails")
+    results_upper = Archive.search("RAILS")
+    assert_equal 1, results_lower.count
+    assert_equal 1, results_upper.count
+    assert_equal "Ruby on Rails Tutorial", results_lower.first.title
+    assert_equal "Ruby on Rails Tutorial", results_upper.first.title
+  end
+
+  test "search returns all when query is blank" do
+    count_with_blank = Archive.search("").count
+    count_with_nil = Archive.search(nil).count
+    assert_equal count_with_nil, count_with_blank
+    assert count_with_blank > 0
+  end
+
+  test "search returns empty for non-matching query" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+
+    results = Archive.search("NonExistentTitle")
+    assert_equal 0, results.count
+  end
 end
