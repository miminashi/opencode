diff --git a/app/assets/stylesheets/pagination.css b/app/assets/stylesheets/pagination.css
new file mode 100644
index 0000000..520ce82
--- /dev/null
+++ b/app/assets/stylesheets/pagination.css
@@ -0,0 +1,39 @@
+.pagination {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: var(--space-xxs);
+  margin-top: var(--space-m);
+  padding: var(--space-s) 0;
+}
+
+.pagination .page,
+.pagination a,
+.pagination span.current {
+  display: inline-block;
+  padding: var(--space-xxs) var(--space-s);
+  border-radius: var(--border-radius);
+  font-weight: bold;
+  text-decoration: none;
+}
+
+.pagination a {
+  color: var(--color-white);
+  background-color: var(--color-secondary);
+}
+
+.pagination a:hover,
+.pagination a:focus {
+  filter: saturate(1.2) brightness(110%);
+}
+
+.pagination span.current {
+  color: var(--color-white);
+  background-image: linear-gradient(to right, var(--color-primary), var(--color-primary-rotate));
+}
+
+.pagination span.disabled {
+  color: var(--color-gray);
+  background-color: var(--color-light);
+  cursor: not-allowed;
+}
