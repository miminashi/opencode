@@ -62,6 +62,28 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should paginate archives on index" do
+    # Create enough archives to exceed one page (20 per page)
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/test#{i}", title: "Paged Video #{i}")
+    end
+
+    get archives_url
+    assert_response :success
+    assert_select ".pagination"
+  end
+
+  test "should show second page when page param is provided" do
+    # Create enough archives to exceed one page (20 per page)
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/page2test#{i}", title: "Page2 Video #{i}")
+    end
+
+    get archives_url, params: { page: "2" }
+    assert_response :success
+    assert_select ".pagination"
+  end
