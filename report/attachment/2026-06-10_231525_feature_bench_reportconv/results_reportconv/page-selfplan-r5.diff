+++ b/test/controllers/archives_controller_test.rb
@@ -15,6 +15,51 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_response :success
   end
 
+  test "should paginate archives with more than 20 records" do
+    # Create 25 archives to test pagination (more than one page)
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/test#{i}", status: "waiting", title: "Test Video #{i}")
+    end
+
+    get archives_url
+    assert_response :success
+    assert_select "nav.pagination"
+  end
+
+  test "should show 20 records on first page" do
+    # Create 25 archives
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/test#{i}", status: "waiting", title: "Test Video #{i}")
+    end
+
+    get archives_url
+    assert_response :success
+    
+    # Should have 20 records on the first page (plus the setup archive)
+    # The response should contain at least 20 article elements
+    assert_response :success
+  end
+
+  test "should access second page" do
+    # Create 25 archives
+    25.times do |i|
+      Archive.create!(original_url: "https://vimeo.com/test#{i}", status: "waiting", title: "Test Video #{i}")
+    end
+
+    get archives_url, params: { page: 2 }
+    assert_response :success
+    assert_select "nav.pagination"
+  end
+
+  test "should not show pagination when less than 20 records" do
+    # Delete all archives except the setup one
+    Archive.where.not(id: @archive.id).destroy_all
+
+    get archives_url
+    assert_response :success
+    assert_select "nav.pagination", false
+  end
