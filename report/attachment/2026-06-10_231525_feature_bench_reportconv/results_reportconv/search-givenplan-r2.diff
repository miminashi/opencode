diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..4952ff3 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,28 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title scope matches partial title" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails 入門")
+    results = Archive.search_by_title("Rails")
+    assert_includes results, archive
+  end
+
+  test "search_by_title scope does not match non-matching title" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Python 講座")
+    results = Archive.search_by_title("Ruby")
+    assert_not_includes results, archive
+  end
+
+  test "search_by_title scope returns all when query is empty" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video")
+    results = Archive.search_by_title("")
+    assert_equal Archive.count, results.count
+  end
+
+  test "search_by_title scope is case insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails")
+    results = Archive.search_by_title("ruby")
+    assert_includes results, archive
+  end
 end
