diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..37d3596 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,26 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "index with q parameter filters archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python Programming")
+
+    get archives_url, params: { q: "Ruby" }
+    assert_response :success
+    assert_includes response.body, "Ruby on Rails"
+    assert_not_includes response.body, "Python Programming"
+
+    get archives_url, params: { q: "python" }
+    assert_response :success
+    assert_includes response.body, "Python Programming"
+    assert_not_includes response.body, "Ruby on Rails"
+
+    get archives_url, params: { q: "nonexistent" }
+    assert_response :success
+    assert_not_includes response.body, "Ruby on Rails"
+    assert_not_includes response.body, "Python Programming"
+  end
+
