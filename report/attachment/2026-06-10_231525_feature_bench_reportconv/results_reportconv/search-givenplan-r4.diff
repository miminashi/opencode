diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..9f316b2 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,30 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title scope returns matching archives" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Python Programming")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1234567", title: "Rails Testing Guide")
+
+    result = Archive.search_by_title("Ruby")
+    assert_equal 1, result.count
+    assert_includes result, archive1
+
+    result = Archive.search_by_title("rails")
+    assert_equal 2, result.count
+    assert_includes result, archive1
+    assert_includes result, archive3
+
+    result = Archive.search_by_title("nonexistent")
+    assert_equal 0, result.count
+  end
+
+  test "search_by_title scope returns all when q is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video 1")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video 2")
+
+    result = Archive.search_by_title("")
+    assert_equal Archive.count, result.count
+  end
 end
