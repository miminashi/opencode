diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..9ae0df3 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,37 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search_by_title returns matching archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails 入門")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Python 基礎講座")
+    Archive.create!(original_url: "https://vimeo.com/1084539", title: "JavaScript 応用")
+
+    result = Archive.search_by_title("Rails")
+    assert_equal 1, result.count
+    assert_includes result, Archive.find_by(title: "Ruby on Rails 入門")
+  end
+
+  test "search_by_title is case insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails 入門")
+
+    result = Archive.search_by_title("rails")
+    assert_equal 1, result.count
+  end
+
+  test "search_by_title returns all when q is blank" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Test Video A")
+    Archive.create!(original_url: "https://vimeo.com/1084538", title: "Test Video B")
+    count_before = Archive.count
+
+    result = Archive.search_by_title("")
+    assert_equal count_before, result.count
+  end
+
+  test "search_by_title returns empty when no match" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails 入門")
+
+    result = Archive.search_by_title("Zzzz nonexistent")
+    assert_equal 0, result.count
+  end
 end
