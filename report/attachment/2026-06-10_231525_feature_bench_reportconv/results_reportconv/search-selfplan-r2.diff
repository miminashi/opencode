diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..27b8d38 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,36 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should search archives by title" do
+    get archives_url, params: { q: "done" }
+    assert_response :success
+    assert_includes response.body, "Done Video"
+  end
+
+  test "should be case insensitive search" do
+    get archives_url, params: { q: "DONE" }
+    assert_response :success
+    assert_includes response.body, "Done Video"
+  end
+
+  test "should not show non-matching results" do
+    get archives_url, params: { q: "zzzznotfound" }
+    assert_response :success
+    assert_not_includes response.body, "Waiting Video"
+    assert_not_includes response.body, "Done Video"
+    assert_not_includes response.body, "Failed Video"
+    assert_not_includes response.body, "Processing Video"
+  end
+
+  test "should show all archives when search is empty" do
+    get archives_url, params: { q: "" }
+    assert_response :success
+    assert_includes response.body, "Waiting Video"
+    assert_includes response.body, "Done Video"
+    assert_includes response.body, "Failed Video"
+    assert_includes response.body, "Processing Video"
+  end
+
