diff --git a/test/controllers/archives_controller_test.rb b/test/controllers/archives_controller_test.rb
index bfe6e04..393228c 100644
--- a/test/controllers/archives_controller_test.rb
+++ b/test/controllers/archives_controller_test.rb
@@ -62,6 +62,36 @@ class ArchivesControllerTest < ActionDispatch::IntegrationTest
     assert_match %r{text/vnd.turbo-stream.html}, response.content_type
   end
 
+  test "should search archives by title" do
+    Archive.create!(original_url: "https://vimeo.com/1000001", status: "done", title: "Ruby on Rails チュートリアル")
+    Archive.create!(original_url: "https://vimeo.com/1000002", status: "done", title: "PostgreSQL 入門")
+    Archive.create!(original_url: "https://vimeo.com/1000003", status: "done", title: "Docker で開発")
+
+    get archives_path, params: { q: "Rails" }
+    assert_response :success
+    assert_select "h2.article__title", text: /Ruby on Rails チュートリアル/
+
+    get archives_path, params: { q: "docker" }
+    assert_response :success
+    assert_select "h2.article__title", text: /Docker で開発/
+    assert_select "h2.article__title", count: 1
+
+    get archives_path, params: { q: "" }
+    assert_response :success
+  end
+
+  test "should search archives by title case-insensitive" do
+    Archive.create!(original_url: "https://vimeo.com/1000004", status: "done", title: "Ruby on Rails チュートリアル")
+
+    get archives_path, params: { q: "rails" }
+    assert_response :success
+    assert_select "h2.article__title", text: /Ruby on Rails チュートリアル/
+
+    get archives_path, params: { q: "RUBY" }
+    assert_response :success
+    assert_select "h2.article__title", text: /Ruby on Rails チュートリアル/
+  end
+
