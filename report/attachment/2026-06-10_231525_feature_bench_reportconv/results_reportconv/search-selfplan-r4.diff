diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..8ac4f70 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,72 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search with nil keyword returns all archives ordered" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Alpha Video")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Beta Video")
+    result = Archive.search(nil)
+    assert_equal 2, result.count
+    assert_equal "Beta Video", result.first.title
+  end
+
+  test "search with empty keyword returns all archives ordered" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Alpha Video")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Beta Video")
+    result = Archive.search("")
+    assert_equal 2, result.count
+    assert_equal "Beta Video", result.first.title
+  end
+
+  test "search with keyword returns matching archives" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+    result = Archive.search("Big")
+    assert_equal 1, result.count
+    assert_equal "Big Buck Bunny", result.first.title
+  end
+
+  test "search with keyword returns partial match" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Test Video")
+    result = Archive.search("Buck")
+    assert_equal 1, result.count
+    assert_equal "Big Buck Bunny", result.first.title
+  end
+
+  test "search with keyword is case-insensitive" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    result = Archive.search("big")
+    assert_equal 1, result.count
+    assert_equal "Big Buck Bunny", result.first.title
+  end
+
+  test "search with non-matching keyword returns empty" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Big Buck Bunny")
+    result = Archive.search("NonExistent")
+    assert_equal 0, result.count
+  end
+
+  test "search with blank keyword returns all archives" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Alpha Video")
+    result = Archive.search("   ")
+    assert_equal 1, result.count
+  end
+
+  test "search returns results ordered by id desc" do
+    Archive.delete_all
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Search Test A")
+    sleep 0.1
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Search Test B")
+    result = Archive.search("Search")
+    assert_equal 2, result.count
+    assert_equal "Search Test B", result.first.title
+  end
 end
