diff --git a/test/models/archive_test.rb b/test/models/archive_test.rb
index 677ed49..b9c38ac 100644
--- a/test/models/archive_test.rb
+++ b/test/models/archive_test.rb
@@ -142,4 +142,46 @@ test "default_title increments for duplicate titles" do
     assert_equal "processing", Archive::Status::PROCESSING
     assert_equal "failed", Archive::Status::FAILED
   end
+
+  test "search scope returns matching archives by partial title match" do
+    archive1 = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+    archive2 = Archive.create!(original_url: "https://vimeo.com/1132937", title: "Rails API Basics")
+    archive3 = Archive.create!(original_url: "https://vimeo.com/1182937", title: "Python Programming")
+
+    results = Archive.search("rails")
+    assert_equal 2, results.count
+    assert_includes results, archive1
+    assert_includes results, archive2
+    assert_not_includes results, archive3
+  end
+
+  test "search scope is case insensitive" do
+    archive = Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+
+    results_upper = Archive.search("RUBY")
+    results_lower = Archive.search("ruby")
+    results_mixed = Archive.search("RuBy")
+
+    assert_equal 1, results_upper.count
+    assert_includes results_upper, archive
+    assert_equal 1, results_lower.count
+    assert_includes results_lower, archive
+    assert_equal 1, results_mixed.count
+    assert_includes results_mixed, archive
+  end
+
+  test "search scope with empty query returns all archives" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Video One")
+    Archive.create!(original_url: "https://vimeo.com/1132937", title: "Video Two")
+
+    results = Archive.search("")
+    assert_equal Archive.all.count, results.count
+  end
+
+  test "search scope with no match returns empty result" do
+    Archive.create!(original_url: "https://vimeo.com/1084537", title: "Ruby on Rails Tutorial")
+
+    results = Archive.search("zxcvbn")
+    assert_equal 0, results.count
+  end
 end
